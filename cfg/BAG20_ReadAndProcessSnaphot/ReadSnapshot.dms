////////////////////////////////////////////////////////////////////////////////////////
//                                                                                    //
//                                                                                    //
//              Configuratie voor project: BAG 2.0 Read And Process Snapshot          //
//                                                                                    //
//                              Object Vision 2021                                    //
//                                                                                    //
////////////////////////////////////////////////////////////////////////////////////////
//                                                                                    //
// Configuratiebestand voor het inlezen van een Snapshot, gemaakt met de BAG tools    //
//                                                                                    //
////////////////////////////////////////////////////////////////////////////////////////

container ReadSnapshot
{
	// De snapshot is een MMD store met alle objecttypes, de adressentabel en de
	// classificaties naast elkaar. De dictionary in de store beschrijft ze, inclusief de
	// relaties ertussen, dus een leesholder declareert zelf niets.
	//
	// Wat een lezer wel zelf moet aanleveren zijn de drie eenheden waar de store met een
	// absoluut pad naar verwijst: /geometries/rdc, /eenheden/jaar en /eenheden/datum.
	container bag
	:	StorageName     = "= SnapshotBaseDir + '/bag.mmd'"
	,	StorageReadOnly = "True"
	{
	}

	// Een leesholder mag geen eigen items dragen, dus de afgeleide attributen staan ernaast.
	container afgeleid
	{
		container pand
		{
			// een polygoon met zichzelf snijden ruimt zelfdoorsnijdingen op
			attribute<geografie/rdc> geometry_cleaned (bag/pand, polygon) := bag/pand/geometry * bag/pand/geometry;
			attribute<geografie/rdc> buffer_m1        (bag/pand, polygon) := geos_buffer_multi_polygon(geometry_cleaned, 1.0, 8b);

			// bouwjaren voor 1000 en na 2100 beschouwen we als missing data
			attribute<eenheden/jaar> bouwjaar_cleaned (bag/pand) :=
				bag/pand/bouwjaar < 1000[eenheden/jaar] || bag/pand/bouwjaar > 2100[eenheden/jaar]
					? (0 / 0)[eenheden/jaar]
					: bag/pand/bouwjaar;

			unit<uint32> ps_uncleaned := sequence2points(bag/pand/geometry);
			unit<uint32> ps_cleaned   := sequence2points(geometry_cleaned);

			parameter<uint32> nr_coord_uncleaned := #ps_uncleaned;
			parameter<uint32> nr_coord_cleaned   := #ps_cleaned;
		}

		container vbo
		{
			// de store bewaart de oppervlakte als getal; hier krijgt die zijn eenheid terug
			attribute<eenheden/m2_int32> oppervlakte (bag/vbo) := bag/vbo/oppervlakte[eenheden/m2_int32];
		}
	}
}
