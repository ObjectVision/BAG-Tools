////////////////////////////////////////////////////////////////////////////////////////
//                                                                                    //
//                                   BAG Toolkit                                      //
//                                                                                    //
//                   Xml2MMD: het BAG 2.0 extract naar MMD-stores                     //
//                                                                                    //
//                              Object Vision 2026                                    //
//                                                                                    //
////////////////////////////////////////////////////////////////////////////////////////
//                                                                                    //
// Het resultaat: een store per objecttype in StoreDir, met alle voorkomens.          //
// Ligplaats, standplaats, openbare ruimte en woonplaats komen uit hun parse in       //
// SourceData; pand, vbo en nummeraanduiding zijn de samenvoeging van hun             //
// tussenstores per fileset (Impl/step2). Elke store draagt zijn codelijsten als      //
// labeltabel mee, dus een lezer declareert niets behalve /Geography/rdc_mm.          //
//                                                                                    //
////////////////////////////////////////////////////////////////////////////////////////

container Store: Using = "Parameters"
{
	unit<uint32> ligplaats := SourceData/ligplaats/ParsedXML/Objecten_ligplaats
	,	StorageName    = "= StoreDir + '/ligplaats.mmd'"
	,	IntegrityCheck = "SourceData/ligplaats/meta/ok"
	{
		attribute<Geography/rdc_mm> geometry (polygon)  := SourceData/ligplaats/mm/result;
		attribute<uint64>           identificatie       := uint64(ligplaats/Objecten_identificatie);
		attribute<uint64>           nummeraanduiding_id := uint64(ligplaats/Objecten_heeftAlsHoofdadres/Objectenref_NummeraanduidingRef[invert(ligplaats/Objecten_heeftAlsHoofdadres/parent_rel[ligplaats])]);

		unit<uint8> status := Classifications/status/ligplaats
		{
			attribute<string> Label := Classifications/status/ligplaats/label, DialogType = "LabelText";
		}

		container meta // op de domain van de store zelf, zodat MMD er geen aparte domain voor vastlegt
		{
			attribute<status> status_rel             (ligplaats) := value(SourceData/ligplaats/meta/status_rel, status);
			attribute<uint32> VOORKOMENIDENTIFICATIE (ligplaats) := SourceData/ligplaats/meta/VOORKOMENIDENTIFICATIE;
			attribute<int32>  BEGINDATUM             (ligplaats) := SourceData/ligplaats/meta/BEGINDATUM;
			attribute<int32>  EINDDATUM              (ligplaats) := SourceData/ligplaats/meta/EINDDATUM;
			attribute<int32>  TIJDSTIPREGISTRATIE    (ligplaats) := SourceData/ligplaats/meta/TIJDSTIPREGISTRATIE;
			attribute<int32>  EINDREGISTRATIE        (ligplaats) := SourceData/ligplaats/meta/EINDREGISTRATIE;
			attribute<int32>  DOCUMENTDATUM          (ligplaats) := SourceData/ligplaats/meta/DOCUMENTDATUM;
			attribute<string> DOCUMENTNUMMER         (ligplaats) := SourceData/ligplaats/meta/DOCUMENTNUMMER;
			attribute<bool>   IS_GECONSTATEERD       (ligplaats) := SourceData/ligplaats/meta/IS_GECONSTATEERD;
		}

		unit<uint32> nevenadres := ligplaats/Objecten_heeftAlsNevenadres/Objectenref_NummeraanduidingRef // 1->0..n relatie
		{
			attribute<ligplaats> ligplaats_rel       := ligplaats/Objecten_heeftAlsNevenadres/Parent_rel[nevenadres/Parent_rel];
			attribute<uint64>    nummeraanduiding_id := uint64(nevenadres/_ValuesTable/Values[nevenadres/value_rel]);
		}
	}

	unit<uint32> standplaats := SourceData/standplaats/ParsedXML/Objecten_standplaats
	,	StorageName    = "= StoreDir + '/standplaats.mmd'"
	,	IntegrityCheck = "SourceData/standplaats/meta/ok"
	{
		attribute<Geography/rdc_mm> geometry (polygon)  := SourceData/standplaats/mm/result;
		attribute<uint64>           identificatie       := uint64(standplaats/Objecten_identificatie);
		attribute<uint64>           nummeraanduiding_id := uint64(standplaats/Objecten_heeftAlsHoofdadres/Objectenref_NummeraanduidingRef[invert(standplaats/Objecten_heeftAlsHoofdadres/parent_rel[standplaats])]);

		unit<uint8> status := Classifications/status/standplaats
		{
			attribute<string> Label := Classifications/status/standplaats/label, DialogType = "LabelText";
		}

		container meta // op de domain van de store zelf, zodat MMD er geen aparte domain voor vastlegt
		{
			attribute<status> status_rel             (standplaats) := value(SourceData/standplaats/meta/status_rel, status);
			attribute<uint32> VOORKOMENIDENTIFICATIE (standplaats) := SourceData/standplaats/meta/VOORKOMENIDENTIFICATIE;
			attribute<int32>  BEGINDATUM             (standplaats) := SourceData/standplaats/meta/BEGINDATUM;
			attribute<int32>  EINDDATUM              (standplaats) := SourceData/standplaats/meta/EINDDATUM;
			attribute<int32>  TIJDSTIPREGISTRATIE    (standplaats) := SourceData/standplaats/meta/TIJDSTIPREGISTRATIE;
			attribute<int32>  EINDREGISTRATIE        (standplaats) := SourceData/standplaats/meta/EINDREGISTRATIE;
			attribute<int32>  DOCUMENTDATUM          (standplaats) := SourceData/standplaats/meta/DOCUMENTDATUM;
			attribute<string> DOCUMENTNUMMER         (standplaats) := SourceData/standplaats/meta/DOCUMENTNUMMER;
			attribute<bool>   IS_GECONSTATEERD       (standplaats) := SourceData/standplaats/meta/IS_GECONSTATEERD;
		}

		unit<uint32> nevenadres := standplaats/Objecten_heeftAlsNevenadres/Objectenref_NummeraanduidingRef // 1->0..n relatie
		{
			attribute<standplaats> standplaats_rel     := standplaats/Objecten_heeftAlsNevenadres/Parent_rel[nevenadres/Parent_rel];
			attribute<uint64>      nummeraanduiding_id := uint64(nevenadres/_ValuesTable/Values[nevenadres/value_rel]);
		}
	}

	// pand, vbo en nummeraanduiding: de samenvoeging van de tussenstores per fileset (stap 2)
	unit<uint32> pand := ='union_unit(' + AsItemList(Impl/step2/pand/fs) + ')'
	,	StorageName = "= StoreDir + '/pand.mmd'"
	{
		attribute<Geography/rdc_mm> geometry (polygon)       := ='union_data(., ' + AsItemList(Impl/step2/pand/fs + '/geometry') + ')';
		attribute<uint64>           identificatie          := ='union_data(., ' + AsItemList(Impl/step2/pand/fs + '/identificatie') + ')';
		attribute<int16>            oorspronkelijkBouwjaar := ='union_data(., ' + AsItemList(Impl/step2/pand/fs + '/oorspronkelijkBouwjaar') + ')';

		unit<uint8> status := Classifications/status/pand
		{
			attribute<string> Label := Classifications/status/pand/label, DialogType = "LabelText";
		}

		container meta // op de domain van de store zelf, zodat MMD er geen aparte domain voor vastlegt
		{
			attribute<status> status_rel             (pand) := ='value(union_data(.., ' + AsItemList(Impl/step2/pand/fs + '/meta/status_rel') + '), status)';
			attribute<uint32> VOORKOMENIDENTIFICATIE (pand) := ='union_data(.., ' + AsItemList(Impl/step2/pand/fs + '/meta/VOORKOMENIDENTIFICATIE') + ')';
			attribute<int32>  BEGINDATUM             (pand) := ='union_data(.., ' + AsItemList(Impl/step2/pand/fs + '/meta/BEGINDATUM') + ')';
			attribute<int32>  EINDDATUM              (pand) := ='union_data(.., ' + AsItemList(Impl/step2/pand/fs + '/meta/EINDDATUM') + ')';
			attribute<int32>  TIJDSTIPREGISTRATIE    (pand) := ='union_data(.., ' + AsItemList(Impl/step2/pand/fs + '/meta/TIJDSTIPREGISTRATIE') + ')';
			attribute<int32>  EINDREGISTRATIE        (pand) := ='union_data(.., ' + AsItemList(Impl/step2/pand/fs + '/meta/EINDREGISTRATIE') + ')';
			attribute<int32>  DOCUMENTDATUM          (pand) := ='union_data(.., ' + AsItemList(Impl/step2/pand/fs + '/meta/DOCUMENTDATUM') + ')';
			attribute<string> DOCUMENTNUMMER         (pand) := ='union_data(.., ' + AsItemList(Impl/step2/pand/fs + '/meta/DOCUMENTNUMMER') + ')';
			attribute<bool>   IS_GECONSTATEERD       (pand) := ='union_data(.., ' + AsItemList(Impl/step2/pand/fs + '/meta/IS_GECONSTATEERD') + ')';
		}
	}

	unit<uint32> vbo := ='union_unit(' + AsItemList(Impl/step2/vbo/fileset/fs) + ')'
	,	StorageName = "= StoreDir + '/vbo.mmd'"
	{
		attribute<Geography/rdc_mm> geometry            := ='union_data(., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/geometry') + ')';
		attribute<uint64>           identificatie       := ='union_data(., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/identificatie') + ')';
		attribute<uint64>           nummeraanduiding_id := ='union_data(., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/nummeraanduiding_id') + ')';
		attribute<int32>            oppervlakte         := ='union_data(., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/oppervlakte') + ')';

		unit<uint8> status := Classifications/status/vbo
		{
			attribute<string> Label := Classifications/status/vbo/label, DialogType = "LabelText";
		}

		container gebruiksdoelen :=
			for_each_nedv(
				  Classifications/gebruiksdoel_vbo/name
				, '= replace(Impl/step2/vbo/gebruiksdoelen_expr, ' + quote(Impl/step2/vbo/gebruiksdoelen_tobereplaced) + ', ' + quote(Classifications/gebruiksdoel_vbo/name) + ')'
				, vbo
				, bool
			);

		container meta // op de domain van de store zelf, zodat MMD er geen aparte domain voor vastlegt
		{
			attribute<status> status_rel             (vbo) := ='value(union_data(.., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/meta/status_rel') + '), status)';
			attribute<uint32> VOORKOMENIDENTIFICATIE (vbo) := ='union_data(.., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/meta/VOORKOMENIDENTIFICATIE') + ')';
			attribute<int32>  BEGINDATUM             (vbo) := ='union_data(.., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/meta/BEGINDATUM') + ')';
			attribute<int32>  EINDDATUM              (vbo) := ='union_data(.., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/meta/EINDDATUM') + ')';
			attribute<int32>  TIJDSTIPREGISTRATIE    (vbo) := ='union_data(.., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/meta/TIJDSTIPREGISTRATIE') + ')';
			attribute<int32>  EINDREGISTRATIE        (vbo) := ='union_data(.., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/meta/EINDREGISTRATIE') + ')';
			attribute<int32>  DOCUMENTDATUM          (vbo) := ='union_data(.., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/meta/DOCUMENTDATUM') + ')';
			attribute<string> DOCUMENTNUMMER         (vbo) := ='union_data(.., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/meta/DOCUMENTNUMMER') + ')';
			attribute<bool>   IS_GECONSTATEERD       (vbo) := ='union_data(.., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/meta/IS_GECONSTATEERD') + ')';
		}

		unit<uint32> polygon := Impl/step2/vbo/polygon // 1->0..1 relatie: het vlak van een vbo zonder punt; geometry van de vbo is dan een punt binnen dit vlak
		{
			attribute<vbo>              vbo_rel         := value(Impl/step2/vbo/polygon/rij, vbo);
			attribute<Geography/rdc_mm> geometry (poly) := ='union_data(., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/polygon/geometry') + ')';
		}

		unit<uint32> gerelateerdPand := Impl/step2/vbo/gerelateerdPand // 1->0..n relatie: de panden waartoe het voorkomen behoort
		{
			attribute<vbo>    vbo_rel := value(Impl/step2/vbo/gerelateerdPand/rij, vbo);
			attribute<uint64> pand_id := ='union_data(., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/gerelateerdPand/pand_id') + ')';
		}

		unit<uint32> nevenadres := Impl/step2/vbo/nevenadres // 1->0..n relatie
		{
			attribute<vbo>    vbo_rel             := value(Impl/step2/vbo/nevenadres/rij, vbo);
			attribute<uint64> nummeraanduiding_id := ='union_data(., ' + AsItemList(Impl/step2/vbo/fileset/fs + '/nevenadres/nummeraanduiding_id') + ')';
		}
	}

	unit<uint32> nummeraanduiding := ='union_unit(' + AsItemList(Impl/step2/nummeraanduiding/fs) + ')'
	,	StorageName = "= StoreDir + '/nummeraanduiding.mmd'"
	{
		attribute<uint64> identificatie     := ='union_data(., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/identificatie') + ')';
		attribute<int32>  huisnummer        := ='union_data(., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/huisnummer') + ')';
		attribute<string> huisletter        := ='union_data(., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/huisletter') + ')';
		attribute<string> toevoeging        := ='union_data(., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/toevoeging') + ')';
		attribute<string> postcode          := ='union_data(., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/postcode') + ')';
		attribute<uint64> openbareruimte_id := ='union_data(., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/openbareruimte_id') + ')';
		attribute<uint64> woonplaats_id     := ='union_data(., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/woonplaats_id') + ')', Descr = "Alleen gevuld als de woonplaats afwijkt van die van de openbare ruimte.";

		attribute<typeAdresseerbaarObject> typeAdresseerbaarObject_rel := ='value(union_data(., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/typeAdresseerbaarObject_rel') + '), typeAdresseerbaarObject)';

		unit<uint8> typeAdresseerbaarObject := Classifications/typeAdresseerbaarObject
		{
			attribute<string> Label := Classifications/typeAdresseerbaarObject/label, DialogType = "LabelText";
		}

		unit<uint8> status := Classifications/status/nummeraanduiding
		{
			attribute<string> Label := Classifications/status/nummeraanduiding/label, DialogType = "LabelText";
		}

		container meta // op de domain van de store zelf, zodat MMD er geen aparte domain voor vastlegt
		{
			attribute<status> status_rel             (nummeraanduiding) := ='value(union_data(.., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/meta/status_rel') + '), status)';
			attribute<uint32> VOORKOMENIDENTIFICATIE (nummeraanduiding) := ='union_data(.., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/meta/VOORKOMENIDENTIFICATIE') + ')';
			attribute<int32>  BEGINDATUM             (nummeraanduiding) := ='union_data(.., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/meta/BEGINDATUM') + ')';
			attribute<int32>  EINDDATUM              (nummeraanduiding) := ='union_data(.., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/meta/EINDDATUM') + ')';
			attribute<int32>  TIJDSTIPREGISTRATIE    (nummeraanduiding) := ='union_data(.., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/meta/TIJDSTIPREGISTRATIE') + ')';
			attribute<int32>  EINDREGISTRATIE        (nummeraanduiding) := ='union_data(.., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/meta/EINDREGISTRATIE') + ')';
			attribute<int32>  DOCUMENTDATUM          (nummeraanduiding) := ='union_data(.., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/meta/DOCUMENTDATUM') + ')';
			attribute<string> DOCUMENTNUMMER         (nummeraanduiding) := ='union_data(.., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/meta/DOCUMENTNUMMER') + ')';
			attribute<bool>   IS_GECONSTATEERD       (nummeraanduiding) := ='union_data(.., ' + AsItemList(Impl/step2/nummeraanduiding/fs + '/meta/IS_GECONSTATEERD') + ')';
		}
	}

	unit<uint32> openbareruimte := SourceData/openbareruimte/ParsedXML/Objecten_openbareruimte
	,	StorageName    = "= StoreDir + '/openbareruimte.mmd'"
	,	IntegrityCheck = "SourceData/openbareruimte/meta/ok && SourceData/openbareruimte/type_ok"
	{
		attribute<uint64> identificatie := uint64(openbareruimte/Objecten_identificatie);
		attribute<string> naam          := MakeDefined(openbareruimte/Objecten_Naam, '');
		attribute<type>   type_rel      := value(SourceData/openbareruimte/type_rel, type);
		attribute<uint64> woonplaats_id := uint64(SourceData/openbareruimte/gerelateerdeWoonplaats_id);

		unit<uint8> type := Classifications/openbareruimte_type
		{
			attribute<string> Label := Classifications/openbareruimte_type/label, DialogType = "LabelText";
		}

		unit<uint8> status := Classifications/status/openbareruimte
		{
			attribute<string> Label := Classifications/status/openbareruimte/label, DialogType = "LabelText";
		}

		container meta // op de domain van de store zelf, zodat MMD er geen aparte domain voor vastlegt
		{
			attribute<status> status_rel             (openbareruimte) := value(SourceData/openbareruimte/meta/status_rel, status);
			attribute<uint32> VOORKOMENIDENTIFICATIE (openbareruimte) := SourceData/openbareruimte/meta/VOORKOMENIDENTIFICATIE;
			attribute<int32>  BEGINDATUM             (openbareruimte) := SourceData/openbareruimte/meta/BEGINDATUM;
			attribute<int32>  EINDDATUM              (openbareruimte) := SourceData/openbareruimte/meta/EINDDATUM;
			attribute<int32>  TIJDSTIPREGISTRATIE    (openbareruimte) := SourceData/openbareruimte/meta/TIJDSTIPREGISTRATIE;
			attribute<int32>  EINDREGISTRATIE        (openbareruimte) := SourceData/openbareruimte/meta/EINDREGISTRATIE;
			attribute<int32>  DOCUMENTDATUM          (openbareruimte) := SourceData/openbareruimte/meta/DOCUMENTDATUM;
			attribute<string> DOCUMENTNUMMER         (openbareruimte) := SourceData/openbareruimte/meta/DOCUMENTNUMMER;
			attribute<bool>   IS_GECONSTATEERD       (openbareruimte) := SourceData/openbareruimte/meta/IS_GECONSTATEERD;
		}
	}

	unit<uint32> woonplaats := SourceData/woonplaats/ParsedXML/Objecten_Woonplaats
	,	StorageName    = "= StoreDir + '/woonplaats.mmd'"
	,	IntegrityCheck = "SourceData/woonplaats/meta/ok"
	{
		attribute<Geography/rdc_mm> geometry (polygon) := SourceData/woonplaats/mm/result;
		attribute<uint64>           identificatie      := uint64(woonplaats/Objecten_identificatie);
		attribute<string>           woonplaatsNaam     := MakeDefined(woonplaats/Objecten_Naam, '');

		unit<uint8> status := Classifications/status/woonplaats
		{
			attribute<string> Label := Classifications/status/woonplaats/label, DialogType = "LabelText";
		}

		container meta // op de domain van de store zelf, zodat MMD er geen aparte domain voor vastlegt
		{
			attribute<status> status_rel             (woonplaats) := value(SourceData/woonplaats/meta/status_rel, status);
			attribute<uint32> VOORKOMENIDENTIFICATIE (woonplaats) := SourceData/woonplaats/meta/VOORKOMENIDENTIFICATIE;
			attribute<int32>  BEGINDATUM             (woonplaats) := SourceData/woonplaats/meta/BEGINDATUM;
			attribute<int32>  EINDDATUM              (woonplaats) := SourceData/woonplaats/meta/EINDDATUM;
			attribute<int32>  TIJDSTIPREGISTRATIE    (woonplaats) := SourceData/woonplaats/meta/TIJDSTIPREGISTRATIE;
			attribute<int32>  EINDREGISTRATIE        (woonplaats) := SourceData/woonplaats/meta/EINDREGISTRATIE;
			attribute<int32>  DOCUMENTDATUM          (woonplaats) := SourceData/woonplaats/meta/DOCUMENTDATUM;
			attribute<string> DOCUMENTNUMMER         (woonplaats) := SourceData/woonplaats/meta/DOCUMENTNUMMER;
			attribute<bool>   IS_GECONSTATEERD       (woonplaats) := SourceData/woonplaats/meta/IS_GECONSTATEERD;
		}
	}

	parameter<string> overzicht := Impl/overzichten/impl/genereer_rapport, Descr = "De tellingen van de run, ook geschreven als overzicht.txt in StoreDir.";
}
