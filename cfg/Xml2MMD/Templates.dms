////////////////////////////////////////////////////////////////////////////////////////
//                                                                                    //
//                                   BAG Toolkit                                      //
//                                                                                    //
//                   Xml2MMD: het BAG 2.0 extract naar MMD-stores                     //
//                                                                                    //
//                              Object Vision 2026                                    //
//                                                                                    //
////////////////////////////////////////////////////////////////////////////////////////
//                                                                                    //
//                            Configuratie van Templates                              //
//                                                                                    //
////////////////////////////////////////////////////////////////////////////////////////

container Templates: Using = "Parameters"
{
	Template meta // De generieke velden van een voorkomen, compact: de status als code, de datums als jjjjmmdd
	{
		// begin case parameters
		unit<uint32>      domain: DisableStorage = "True";
		attribute<string> STATUS (domain);
		attribute<string> identificatie (domain);
		unit<uint8>       statustype;
		// end case parameters

		unit<uint32> Objecten_voorkomen := domain/Objecten_voorkomen, DisableStorage = "True";

		attribute<Objecten_voorkomen> Objecten_rel (domain) := invert(value(Objecten_voorkomen/Parent_rel, domain)), DisableStorage = "True";

		// een voorkomen zonder status krijgt code 0, 'onbekend'; een status die niet in de lijst staat blijft
		// null en status_bekend stopt dan de run, zodat een nieuwe waarde van het Kadaster niet stil wegvalt
		attribute<string>     status_tekst (domain) := MakeDefined(STATUS, '') == '' ? 'onbekend' : lowercase(STATUS), DisableStorage = "True";
		attribute<statustype> status_rel   (domain) := rlookup(status_tekst, lowercase(statustype/label));
		parameter<bool>       status_bekend        := all(IsDefined(status_rel));
		parameter<bool>       ids_ok               := all(IsDefined(uint64(identificatie))), Descr = "Elke identificatie is een getal; de BAG levert zestien cijfers (woonplaats vier).";
		parameter<bool>       ok                   := status_bekend && ids_ok, Descr = "De IntegrityCheck van de store: een onbekende status of een identificatie die geen getal is stopt de run.";

		attribute<uint32> VOORKOMENIDENTIFICATIE   (domain) := domain/Objecten_voorkomen/Historie_voorkomenidentificatie[Objecten_rel][uint32];
		attribute<int32>  BEGINDATUM               (domain) := MakeDefined(replace(substr(domain/Objecten_voorkomen/Historie_beginGeldigheid[Objecten_rel], 0, 10), '-', '')[int32], 0i);
		attribute<int32>  EINDDATUM                (domain) := MakeDefined(replace(substr(domain/Objecten_voorkomen/Historie_eindGeldigheid [Objecten_rel], 0, 10), '-', '')[int32], 0i);

		// de BAG levert een tijdstip ('2010-09-28T14:47:00.000'); de store bewaart de datum, 0 als het ontbreekt
		attribute<int32>  TIJDSTIPREGISTRATIE      (domain) := MakeDefined(replace(substr(domain/Objecten_voorkomen/Historie_tijdstipRegistratie[Objecten_rel], 0, 10), '-', '')[int32], 0i);
		attribute<int32>  EINDREGISTRATIE          (domain) := MakeDefined(replace(substr(domain/Objecten_voorkomen/Historie_eindRegistratie    [Objecten_rel], 0, 10), '-', '')[int32], 0i);

		attribute<int32>  DOCUMENTDATUM            (domain) := MakeDefined(replace(substr(domain/Objecten_documentdatum, 0, 10), '-', '')[int32], 0i);
		attribute<string> DOCUMENTNUMMER           (domain) := MakeDefined(domain/Objecten_documentnummer, '');

		attribute<bool>   IS_GECONSTATEERD         (domain) := UpperCase(MakeDefined(domain/Objecten_geconstateerd, 'N')) == 'J';
	}

	Template polygon_mm // Een vlak van meters (dpoint) naar millimeters (ipoint), per punt afgerond
	{
		// begin case parameters
		unit<uint32>              domain;
		attribute<geometries/rdc> geometry (domain, poly);
		// end case parameters

		unit<uint32> punten := sequence2points(geometry)
		{
			attribute<geometries/rdc_mm_rond> rond          := point[geometries/rdc_mm_rond];
			attribute<geometries/rdc_mm>      mm            := point_yx(PointRow(rond), PointCol(rond), geometries/rdc_mm);
			attribute<bool>                   buiten_bereik := !IsDefined(rond) || !IsDefined(point);
			attribute<bool>                   weglaten      := vlak_buiten_bereik[sequence_rel];
		}

		// Een coordinaat verder dan 2.147 km van de oorsprong past niet in ipoint (int32) in millimeters; zulke vlakken
		// zijn datafouten (op het extract van 2026-10-08 108 pandvoorkomens). Zo'n vlak wordt leeg, want een vlak met
		// een null-punt laat centroid_or_mid omvallen (GeoDMS 20.23.1, ObjectVision/GeoDMS#1314).
		attribute<bool> vlak_buiten_bereik (domain) := any(punten/buiten_bereik, punten/sequence_rel);

		unit<uint32> punten_ok := select_with_org_rel(!punten/weglaten)
		{
			attribute<geometries/rdc_mm> mm      := punten/mm[org_rel];
			attribute<domain>            seq     := punten/sequence_rel[org_rel];
			attribute<uint32>            ordinal := punten/ordinal[org_rel];
		}
		attribute<geometries/rdc_mm> result (domain, poly) := points2polygon(punten_ok/mm, punten_ok/seq, punten_ok/ordinal);
	}

	Template posListProcessor
	{
		// begin case parameters
		unit<uint32> posList;
		parameter<bool> isExterior;
		attribute<gmlPolygon> polygon_rel (posList); // het gml:Polygon waar deze ring toe behoort
		// end case parameters

		unit<uint32> impl := posList
		{
			attribute<string> values := _ValuesTable/Values[value_rel];

			attribute<uint32> srsDimension_with_nullvalues := MakeDefined(strlen(posList/srsDimension), 0) == 0 // een ontbrekend XML-attribuut is sinds GeoDMS 20.23.0 null, daarvoor een lege string
				? uint32(gmlPolygon/srsDimension[polygon_rel]) // als de poslist geen srsdimension heeft, nemen we die van het gml:Polygon
				: uint32(posList/srsDimension);
			attribute<uint32> srsDimension := MakeDefined(srsDimension_with_nullvalues, srsDimensionDefaultValue)
			, IntegrityCheck = "srsDimension == 2 || srsDimension == 3";

			attribute<string>  str_sequence        := '{'+string(uint32(count) * srsDimension) + ':' + values + '}';
			attribute<float64> f64_sequence (arc)  := float64Seq(str_sequence); // een kale coordinatenreeks, geen polygoon

			unit<uint32> posListUnit := range(uint32, 0, #posList) // trick to avoid coordinates/Sequence_rel having an untraceable values unit.
			{
				attribute<uint32> nrCoordPerPoint := union_data(posListUnit, srsDimension);
			}

			unit<uint32> coordinates := sequence2points(union_data(posListUnit, f64_sequence));

			unit<uint32> p := select_with_attr_by_org_rel(coordinates, coordinates/ordinal % posListUnit/nrCoordPerPoint[coordinates/Sequence_rel] == 0)
			{
				attribute<float64>     x    := point;
				attribute<float64>     y    := coordinates/point[org_rel + 1];
				attribute<geometries/rdc>   p_m  := point_yx(y, x, geometries/rdc);
				attribute<posListUnit> s    := Sequence_rel;
				attribute<uint32>      fo   := ordinal / posListUnit/nrCoordPerPoint[s]; // forward winding
				attribute<uint32>      ro   := pcount(s)[s] - fo - 1; // reverse winding*/
			}

			attribute<geometries/rdc> geometry (poly) := union_data(posList, points2polygon_pso(p/p_m, p/s, isExterior ? p/ro : p/fo));
		}
		attribute<geometries/rdc> result (posList, poly) := impl/geometry;
	}

	// Alles rekent in geometries/rdc (dpoint), van het parsen van de posList tot het afronden op millimeters
	// voor de store. De geos_*-polygoonoperatoren accepteren sinds GeoDMS 20.16.0 alleen nog dpoint, en ook
	// '-' en '+' worden op dpoint door GEOS uitgevoerd in plaats van door boost::polygon, dat integer-
	// coordinaten vereist. Zie GitHub issue #1.
	// De familie (geos_ of dms_) volgt uit GeoEngine (ConfigSettings/Overridable/GEO_ENGINE): dms_union_polygon
	// (GeoDMS 20.20.0) leest ringen onder de even-odd-regel, zodat een tegen de klok in opgeslagen pand
	// (GeoDMS #1230) geen reparatie nodig heeft; de geos-weg blijft zoals hij was.
	Template union
	{
		// begin case parameters
		unit<uint32>         child;
		unit<uint32>         parent;
		attribute<geometries/rdc> geometry   (child, poly);
		attribute<parent>    parent_rel (child);
		// end case parameters

		attribute<geometries/rdc> result (poly, parent) := = GeoEngine + '_union_polygon(geometry, parent_rel)';
	}

	Template optimized_union
	{
		// begin case parameters
		unit<uint32>         child;
		unit<uint32>         parent;
		attribute<geometries/rdc> geometry   (child, poly);
		attribute<parent>    parent_rel (child);
		// end case parameters

		container impl
		{
			attribute<uint32> count (parent) := pcount(parent_rel);
			unit<uint32> childCopy := range(child, 0, #child);

			unit<uint32> nonTrivialChild := select_with_org_rel((count != 1)[union_data(childCopy, parent_rel)])
			{
				attribute<child>  child_rel            := value(org_rel, child);
				attribute<geometries/rdc> union (poly, parent) := = GeoEngine + '_union_polygon(geometry[child_rel], parent_rel[child_rel])';
			}
		}
		attribute<geometries/rdc> result (poly,parent) := impl/count <= 1 ? geometry[invert(parent_rel)] : impl/nonTrivialChild/union;
	}

	Template one2one_union
	{
		// begin case parameters
		unit<uint32>         child;
		unit<uint32>         parent;
		attribute<geometries/rdc> geometry   (child, poly);
		attribute<parent>    parent_rel (child);
		// end case parameters

		container impl
		{
			parameter<bool> Check := (#child == #parent) && all(parent_rel == ID(child)[parent]);
		}
		attribute<geometries/rdc> result (poly, parent) := union_data(parent, geometry), IntegrityCheck = "impl/Check";
	}

	Template LinearRing
	{
		// begin case parameters
		unit<uint32>          parsedXMLsrc;
		parameter<bool>       isExterior;
		attribute<gmlPolygon> polygon_rel (parsedXMLsrc/gml_posList);
		// end case parameters

		container impl
		{
			container posList := posListProcessor(parsedXMLsrc/gml_posList, isExterior, polygon_rel);
			container union   := one2one_union(parsedXMLsrc/gml_posList, parsedXMLsrc, posList/result, parsedXMLsrc/gml_posList/Parent_rel);
		}
		attribute<geometries/rdc> geometry (poly,parsedXMLsrc) := impl/union/result;
	}

	Template Polygon
	{
		// begin case parameters
		unit<uint32>         Exterior;
		attribute<geometries/rdc> ExtGeometry (Exterior, poly);
		unit<uint32>         Interior;
		attribute<geometries/rdc> IntGeometry (Interior, poly);
		attribute<Exterior>  Parent_rel  (Interior);
		// end case parameters

		container impl
		{
			container IntUnion := optimized_union(Interior, Exterior, IntGeometry, Parent_rel);
			attribute<uint32> count (Exterior) := pcount(parent_rel);

			unit<uint32> ExtCopy := range(Exterior, 0, #Exterior)
			{
				attribute<uint32> count2 := union_data(., count);
			}

			unit<uint32> nonTrivialExterior := select_with_org_rel(ExtCopy/count2 > 0)
			{
				attribute<Exterior> Exterior_rel := value(org_rel, Exterior);
				attribute<geometries/rdc> diff (poly) := ExtGeometry[Exterior_rel] - IntUnion/result[Exterior_rel];
			}

			attribute<geometries/rdc> result (poly,Exterior) := impl/nonTrivialExterior/diff[invert(impl/nonTrivialExterior/Exterior_rel)];
		}
		attribute<geometries/rdc> result (poly,Exterior) :=
			impl/count == 0
				? ExtGeometry
				: impl/result;
	}

	Template ProcessGmlPolygonImpl
	{
		// begin case parameters
		unit<uint32> gmlPolygon;
		// end case parameters

		// srsDimension van een ring zonder eigen srsDimension komt van zijn gml:Polygon; voor binnenringen loopt die relatie via gml_Interior
		attribute<gmlPolygon> InteriorPolygon_rel (gmlPolygon/gml_Interior/gml_posList) := gmlPolygon/gml_Interior/Parent_rel[gmlPolygon/gml_Interior/gml_posList/Parent_rel];

		container Exterior := Templates/LinearRing(gmlPolygon,              true,  gmlPolygon/gml_posList/Parent_rel);
		container Interior := Templates/LinearRing(gmlPolygon/gml_Interior, false, InteriorPolygon_rel);
		container Polygon  := Templates/Polygon(
			gmlPolygon,              Exterior/geometry,
			gmlPolygon/gml_Interior, Interior/geometry,
			gmlPolygon/gml_Interior/Parent_rel
		);
	}

	Template ProcessGmlPolygon
	{
		// begin case parameters
		unit<uint32>    gmlContext;
		parameter<bool> hasMultiplePolygons;
		// end case parameters

		container impl := ProcessGmlPolygonImpl(gmlContext/gml_Polygon);

		parameter<string> geometry_expr := hasMultiplePolygons
			? 'Templates/optimized_union(impl/gmlPolygon, gmlContext, impl/Polygon/result, impl/gmlPolygon/Parent_rel)'
			: 'Templates/one2one_union(impl/gmlPolygon, gmlContext, impl/Polygon/result, impl/gmlPolygon/Parent_rel)';

		container geometry := = geometry_expr;
		attribute<geometries/rdc> result (gmlContext, polygon) := geometry/result;
	}
}
