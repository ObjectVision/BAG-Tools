////////////////////////////////////////////////////////////////////////////////////////
//                                                                                    //
//                                   BAG Toolkit                                      //
//                                                                                    //
//                   Xml2MMD: het BAG 2.0 extract naar MMD-stores                     //
//                                                                                    //
//                              Object Vision 2026                                    //
//                                                                                    //
////////////////////////////////////////////////////////////////////////////////////////
//                                                                                    //
// Het overzicht met tellingen van een run: elk item onder rapport wordt een regel    //
// in overzicht.txt, met de naam als label; een container impl blijft erbuiten.       //
//                                                                                    //
////////////////////////////////////////////////////////////////////////////////////////

container overzichten: Using = "Parameters"
{
	container impl
	{
		parameter<string> tab     := '\t';
		parameter<string> newline := '\n';

		parameter<string> rapport_fullname := PropValue(rapport, 'FullName');

		unit<uint32> rapport_items := SubTree_PropValues(rapport,'fullname')
		{
			attribute<string> expr    := union_data(.,rapport_items_expr/expr);
			attribute<string> name    := union_data(.,rapport_items_name/name);
			attribute<uint32> relpos  := strpos(fullname, 'rapport');
			attribute<string> relname := substr(fullname, relpos, strlen(fullname) - relpos), Descr = "De naam vanaf rapport, ook als pad naar het item.";
		}
		unit<uint32> rapport_items_expr := SubTree_PropValues(rapport,'expr');
		unit<uint32> rapport_items_name := SubTree_PropValues(rapport,'name');

		unit<uint32> rapport_items_sel := select_with_attr_by_cond(rapport_items, strcount(lowercase(rapport_items/relname), '/impl') == 0)
		{
			attribute<uint32> level := strcount(fullname, '/') - strcount(rapport_fullname, '/') - 1;
			attribute<string> item  := strlen(expr) >= 1 ? relname : quote(name), Descr = "Een item met expressie wordt zijn waarde, een container zijn naam.";
			attribute<string> label := repeat(tab,level) + name + ': ';
		}

		parameter<string> seperator := ' + ' + quote(newline) + ' + ';
		parameter<string> genereer_rapport_expr :=
			AsList(
				quote(rapport_items_sel/label) + ' + ' + 'string(' + rapport_items_sel/item + ')'
				, seperator
			);
		parameter<string> genereer_rapport := = genereer_rapport_expr
		,	StorageName = "= StoreDir + '/overzicht.txt'"
		,	StorageType = "str";
	}

	container rapport
	{
		parameter<string> datum        := date;
		parameter<string> XML_folder   := expand(.,XmlDir);
		parameter<string> Store_folder := expand(.,StoreDir);

		container xml_bestanden
		{
			parameter<uint32> nr_bestanden_ligplaats        := #SourceData/folderinfo/bestand_selectie/xml_bestanden/ligplaats;
			parameter<uint32> nr_bestanden_standplaats      := #SourceData/folderinfo/bestand_selectie/xml_bestanden/standplaats;
			parameter<uint32> nr_bestanden_pand             := #SourceData/folderinfo/bestand_selectie/xml_bestanden/pand;
			parameter<uint32> nr_bestanden_vbo              := #SourceData/folderinfo/bestand_selectie/xml_bestanden/vbo;
			parameter<uint32> nr_bestanden_nummeraanduiding := #SourceData/folderinfo/bestand_selectie/xml_bestanden/nummeraanduiding;
			parameter<uint32> nr_bestanden_openbareruimte   := #SourceData/folderinfo/bestand_selectie/xml_bestanden/openbareruimte;
			parameter<uint32> nr_bestanden_woonplaats       := #SourceData/folderinfo/bestand_selectie/xml_bestanden/woonplaats;
		}
		container bag_objecten
		{
			parameter<uint32> nr_ligplaats_voorkomens        := #Store/ligplaats;
			parameter<uint32> nr_standplaats_voorkomens      := #Store/standplaats;
			parameter<uint32> nr_pand_voorkomens             := #Store/pand;
			parameter<uint32> nr_vbo_voorkomens              := #Store/vbo;
			parameter<uint32> nr_vbo_met_vlak                := #Store/vbo/polygon;
			parameter<uint32> nr_vbo_pand_relaties           := #Store/vbo/gerelateerdPand;
			parameter<uint32> nr_nummeraanduiding_voorkomens := #Store/nummeraanduiding;
			parameter<uint32> nr_openbareruimte_voorkomens   := #Store/openbareruimte;
			parameter<uint32> nr_woonplaats_voorkomens       := #Store/woonplaats;
		}
		container buiten_bereik
		{
			// een coordinaat verder dan 2.147 km van de oorsprong past niet in millimeters; zo'n pand heeft een leeg vlak, zo'n vbo geen punt
			parameter<uint32> nr_pand_zonder_vlak := sum_uint32(impl/n_punten == 0);
			parameter<uint32> nr_vbo_zonder_punt  := sum_uint32(!IsDefined(Store/vbo/geometry));
			container impl
			{
				unit<uint32>      p        := sequence2points(Store/pand/geometry);
				attribute<uint32> n_punten (Store/pand) := pcount(p/sequence_rel);
			}
		}
	}
}
