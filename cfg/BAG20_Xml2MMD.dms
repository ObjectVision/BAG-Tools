////////////////////////////////////////////////////////////////////////////////////////
//                                                                                    //
//                                                                                    //
//              Configuratie voor project: BAG 2.0 XML bronfiles > MMD                //
//                                                                                    //
//                              Object Vision 2023                                    //
//                                                                                    //
////////////////////////////////////////////////////////////////////////////////////////
//                                                                                    //
// Hoe een nieuwe BAG te verkrijgen en tot MMD stores om te zetten:                   //
// 1. Download je  BAG via:                                                           //
// https://www.kadaster.nl/-/kosteloze-download-bag-2.0-extract                       //
//                                                                                    //
// 2. Pak alleen de zip bestanden:                                                    //
// - 9999LIGdatum                                                                     //
// - 9999NUMdatum                                                                     //
// - 9999OPRdatum                                                                     //
// - 9999PNDdatum                                                                     //
// - 9999STAdatum                                                                     //
// - 9999VBOdatum                                                                     //
// - 9999WPLdatum                                                                     //
// uit in een subfolder en configureer deze als XmlDir                                //
//                                                                                    //
// 3. Configureer de date parameter met als conventie: yyyymmdd                       //
//                                                                                    //
// 4. Open deze configuratie en activeer de optie: MaakMMDBestanden                   //
//                                                                                    //
//  De BAG inclusief historie wordt nu weggeschreven naar een set van MMD stores in   //
//  de StoreDir.                                                                      //
//                                                                                    //
// Voor meer informatie, zie:                                                         //
//  https://github.com/ObjectVision/BAG-Tools/wiki/BAG20-Xml2MMD                      //
//                                                                                    //
////////////////////////////////////////////////////////////////////////////////////////

container BAG20_Xml2MMD: IntegrityCheck = "GeoDMSVersion() >= 20.20" // GeoDMS 20.20.0 of later: de dms_-polygoonoperatoren en de do-ketens
{
	// te configureren
	// GEO_ENGINE kiest de familie polygoonoperatoren: 'geos' (default) of 'dms'. De waarde is een
	// ConfigSettings/Overridable-instelling, dus op de commandoregel te zetten met de omgevingsvariabele
	// GEODMS_Overridable_GEO_ENGINE=dms (de batchbestanden vertalen het argument GEO_ENGINE=dms daarheen).
	container ConfigSettings
	{
		container Overridable
		{
			parameter<string> GEO_ENGINE := 'geos';
		}
	}
	parameter<string> GeoEngine := expand(., '%GEO_ENGINE%');

	parameter<string> date     := '20261008';
	//

	parameter<string> date_dir := '%SourceDataDir%/BAG/' + date;

	parameter<string> XmlDir   := date_dir + '/NGR';
	parameter<string> StoreDir := date_dir + '/mmd';

	parameter<string> MaakMMDBestanden := xml/folderinfo/CanGenerate == 2b
		? 'Cannot make list of files, ' + expand(., XmlDir) + ' does not consist or contains no .xml files.'
		:  xml/folderinfo/CanGenerate == 1b
			? 'Data from ' + expand(., XmlDir) + ' is probably not in requested BAG 2.0 format, make sure you only unzipped: LIG, NUM, OPR, PND, STA, VBO, WPL ZIP files'
			: 'Ready'
	, ExplicitSuppliers = "= SupplierList";

	parameter<string> SupplierList     := xml/folderinfo/CanGenerate == 0b
		? 'Store/ligplaats;Store/standplaats;Store/pand;Store/vbo;Store/nummeraanduiding;Store/openbareruimte;Store/woonplaats;Store/overzicht'
		: '';

	// De MMD-dictionary noemt units die buiten de store staan bij hun absolute pad, dus deze naam
	// moet gelijk zijn aan die in BAG20_MakeSnaphot: /geometries/rdc.
	container geometries
	{
		unit<dpoint> rdc_base : SpatialReference = "EPSG:28992";
		unit<dpoint> rdc      := range(rdc_base, point_yx(300000d,0d), point_yx(625000d,280000d));
	}

	parameter<uint32> srsDimensionDefaultValue := 2;

	container typeringen
	{
		unit<uint8> gebruiksdoel_vbo : nrofrows = 11
		{
			attribute<string> label:
			[
			  'bijeenkomstfunctie','celfunctie','gezondheidszorgfunctie','industriefunctie','kantoorfunctie','logiesfunctie'
			 ,'onderwijsfunctie','overige gebruiksfunctie','sportfunctie','winkelfunctie','woonfunctie'
			];
			attribute<string> name      := replace(label,' ','_');
			attribute<string> name_kort := replace(name, 'functie','');
		}
	}

	#include<Store.dms>
	#include<XML.dms>
	#include<Templates.dms>
	#include<overzichten.dms>
}
