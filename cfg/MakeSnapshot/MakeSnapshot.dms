////////////////////////////////////////////////////////////////////////////////////////
//                                                                                    //
//                                   BAG Toolkit                                      //
//                                                                                    //
//              MakeSnapshot: de BAG op een peildatum uit de MMD-stores               //
//                                                                                    //
//                              Object Vision 2026                                    //
//                                                                                    //
////////////////////////////////////////////////////////////////////////////////////////
//                                                                                    //
// Template die per objecttype de voorkomens op de peildatum selecteert, per object   //
// een voorkomen kiest en de snapshot wegschrijft.                                    //
//                                                                                    //
// Per objecttype: src is de store van Xml2MMD (alle voorkomens, millimeters, codes), //
// afgeleid zet de geometrie om naar meters en de statuscode naar Classifications,    //
// selectie zijn de voorkomens die op de peildatum geldig zijn en aan de selecties    //
// voldoen, result is een rij per object met keuze, de rij in selectie van het        //
// voorkomen met de hoogste voorkomenidentificatie.                                   //
//                                                                                    //
////////////////////////////////////////////////////////////////////////////////////////

template Snapshot_T
{
	// begin case parameters
	parameter<eenheden/datum> prik_datum;
	parameter<bool>           met_geo_sel;
	parameter<bool>           met_status_sel;
	parameter<bool>           met_vreemde_waarden_sel;
	parameter<bool>           met_pandhoogte_attributen;
	parameter<string>         format_export;
	// end case parameters

	parameter<string> SnapshotGeoDirPart := met_geo_sel ? geo_selectie/Label + '/' : '';
	parameter<string> SnapshotDir        := SnapshotBaseDir + '/' + SnapshotGeoDirPart + string(prik_datum) + '.new';

	parameter<bool> WriteToMMD := lowercase(format_export) = 'mmd';

	parameter<string> SuppliersExprAll := isValidStoreDir
		? 	WriteToMMD
			?
				'snapshot_store;'
				'object/overzichten/impl/genereer_rapport'
				+ (met_pandhoogte_attributen ? ';pandhoogte_store' : '')
			: 'gdalwrite_vect_export/result/make_geopackage '
		: '';

	parameter<string> SuppliersExprAdres := isValidStoreDir
		?
			'snapshot_store'
		: '';

	parameter<string> MaakVolledigeSnapshot := isValidStoreDir ? 'ready' : 'Folder : ' + expand(., StoreDir) + ' bevat geen stores van Xml2MMD'
	,  ExplicitSuppliers = "= SuppliersExprAll";

	parameter<string> MaakAlleenAdressenTabel := isValidStoreDir ? 'ready' : 'Folder : ' + expand(., StoreDir)+ ' bevat geen stores van Xml2MMD'
	,  ExplicitSuppliers = "= SuppliersExprAdres";

	container object
	{
		container ligplaats
		{
			unit<uint32> src
			: StorageName     = "= StoreDir + '/ligplaats.mmd'"
			, StorageReadOnly = "True"
			{
			}

			// Een MMD-leesholder mag zelf niets declareren; de dictionary van de store doet dat.
			// Alles wat niet uit de store komt, staat daarom hier.
			container afgeleid
			{
				attribute<Geography/rdc> geometry (src, polygon) := src/geometry[Geography/rdc];
				container status := status_selectie(src, Classifications/status/ligplaats, src/status, src/status/Label, src/meta/status_rel);
				container geo_selectie := = met_geo_sel
					? 'polygon_selectie(src, afgeleid/geometry)'
					: 'nl_selectie(src)';
			}
			container impl:=
				='datum_conditie(src, prik_datum, src/meta/BEGINDATUM, src/meta/EINDDATUM, afgeleid/status/status_sel, '+ (met_geo_sel
						? 'True,  afgeleid/geo_selectie/result'
						: 'False'
					)
				+ ')'
			;

			// De selectie hoort hier en niet in de template: een unit die als case parameter wordt
			// meegegeven draagt de sub-items van een MMD store niet mee (GeoDMS 20.19.1).
			unit<uint32> selectie := select_with_attr_by_org_rel(src, impl/conditie)
			, DialogType = "Map"
			, DialogData = "geometry_m"
			{
				container meta := collect_attr_by_org_rel(src/meta, selectie, org_rel);
				attribute<Classifications/status/ligplaats> status_rel := afgeleid/status/status_rel[org_rel];
				attribute<Geography/rdc> geometry_m (polygon) := afgeleid/geometry[org_rel];
				attribute<result> result_rel := rlookup(identificatie, result/values);
				attribute<uint64> sleutel    := uint64(result_rel) * voorkomen_factor + uint64(meta/VOORKOMENIDENTIFICATIE);
			}
			unit<uint32> result := unique(selectie/identificatie)
			{
				attribute<uint32>         count                 := pcount(selectie/result_rel), DisableStorage = "True";
				attribute<selectie>       keuze                 := rlookup(uint64(id(.)) * voorkomen_factor + uint64(max(selectie/meta/VOORKOMENIDENTIFICATIE, selectie/result_rel)), selectie/sleutel), DisableStorage = "True";

				attribute<uint64>         values                : DisableStorage = "True";
				attribute<uint64>         identificatie         := values;
				attribute<Geography/rdc> geometry    (polygon) := selectie/geometry_m[keuze];
				attribute<uint64>         nummeraanduiding_id   := selectie/nummeraanduiding_id[keuze];

				container meta := meta_template(selectie, ., Classifications/status/ligplaats);

				unit<uint32> nevenadres := select_with_attr_by_cond(src/nevenadres, IsDefined(rlookup(src/nevenadres/ligplaats_rel, selectie/org_rel))) // is een 1->0..n relatie
				{
					attribute<uint64> identificatie := src/identificatie[ligplaats_rel];
				}
			}
		}

		container standplaats
		{
			unit<uint32> src
			: StorageName     = "= StoreDir + '/standplaats.mmd'"
			, StorageReadOnly = "True"
			{
			}

			container afgeleid
			{
				attribute<Geography/rdc> geometry (src, polygon) := src/geometry[Geography/rdc];
				container status := status_selectie(src, Classifications/status/standplaats, src/status, src/status/Label, src/meta/status_rel);
				container geo_selectie := = met_geo_sel
					? 'polygon_selectie(src, afgeleid/geometry)'
					: 'nl_selectie(src)';
			}
			container impl :=
				='datum_conditie(src, prik_datum, src/meta/BEGINDATUM, src/meta/EINDDATUM, afgeleid/status/status_sel, '+ (met_geo_sel
						? 'True,  afgeleid/geo_selectie/result'
						: 'False'
					)
				+ ')'
			;

			unit<uint32> selectie := select_with_attr_by_org_rel(src, impl/conditie)
			, DialogType = "Map"
			, DialogData = "geometry_m"
			{
				container meta := collect_attr_by_org_rel(src/meta, selectie, org_rel);
				attribute<Classifications/status/standplaats> status_rel := afgeleid/status/status_rel[org_rel];
				attribute<Geography/rdc> geometry_m (polygon) := afgeleid/geometry[org_rel];
				attribute<result> result_rel := rlookup(identificatie, result/values);
				attribute<uint64> sleutel    := uint64(result_rel) * voorkomen_factor + uint64(meta/VOORKOMENIDENTIFICATIE);
			}

			unit<uint32> result := unique(selectie/identificatie)
			{
				attribute<uint32>         count                 := pcount(selectie/result_rel), DisableStorage = "True";
				attribute<selectie>       keuze                 := rlookup(uint64(id(.)) * voorkomen_factor + uint64(max(selectie/meta/VOORKOMENIDENTIFICATIE, selectie/result_rel)), selectie/sleutel), DisableStorage = "True";

				attribute<uint64>         values                : DisableStorage = "True";
				attribute<uint64>         identificatie         := values;
				attribute<Geography/rdc> geometry    (polygon) := selectie/geometry_m[keuze];
				attribute<uint64>         nummeraanduiding_id   := selectie/nummeraanduiding_id[keuze];

				container meta := meta_template(selectie, ., Classifications/status/standplaats);

				unit<uint32> nevenadres := select_with_attr_by_cond(src/nevenadres, IsDefined(rlookup(src/nevenadres/standplaats_rel, selectie/org_rel))) // is een 1->0..n relatie
				{
					attribute<uint64> identificatie := src/identificatie[standplaats_rel];
				}
			}
		}

		container pand
		{
			unit<uint32> src
			: StorageName     = "= StoreDir + '/pand.mmd'"
			, StorageReadOnly = "True"
			{
			}

			container afgeleid
			{
				attribute<Geography/rdc> geometry (src, polygon) := src/geometry[Geography/rdc];
				container status       := status_selectie(src, Classifications/status/pand, src/status, src/status/Label, src/meta/status_rel);
				container geo_selectie := = met_geo_sel
					? 'polygon_selectie(src, afgeleid/geometry)'
					: 'nl_selectie(src)';
			}

			container vreemde_waarden_filter
			{
				unit<float64>             m2                           := eenheden/m * eenheden/m;
				attribute<m2>             oppervlakte            (src) := area(afgeleid/geometry, m2);

				attribute<Geography/rdc> lower_bound            (src) := lower_bound(afgeleid/geometry);
				attribute<Geography/rdc> upper_bound            (src) := upper_bound(afgeleid/geometry);
				attribute<eenheden/m>     X_lower_bound          (src) := pointCol(lower_bound)[eenheden/m];
				attribute<eenheden/m>     X_upper_bound          (src) := pointCol(upper_bound)[eenheden/m];
				attribute<eenheden/m>     Y_lower_bound          (src) := pointRow(lower_bound)[eenheden/m];
				attribute<eenheden/m>     Y_upper_bound          (src) := pointRow(upper_bound)[eenheden/m];
				attribute<eenheden/m>     lengte                 (src) := X_upper_bound - X_lower_bound;
				attribute<eenheden/m>     breedte                (src) := Y_upper_bound - Y_lower_bound;

				attribute<Geography/rdc> centroid_or_mid        (src) := centroid_or_mid(afgeleid/geometry);
				attribute<eenheden/m>     X_centroid_or_mid      (src) := pointCol(centroid_or_mid)[eenheden/m];
				attribute<eenheden/m>     Y_centroid_or_mid      (src) := pointRow(centroid_or_mid)[eenheden/m];
				attribute<bool>           in_NL                  (src) :=
					   X_centroid_or_mid >      0[eenheden/m] && X_centroid_or_mid <= 280000[eenheden/m]
					&& Y_centroid_or_mid > 300000[eenheden/m] && Y_centroid_or_mid <= 625000[eenheden/m];

				attribute<bool>           geen_zeer_grote_panden_in_NL (src) := oppervlakte < 100000000[m2] && lengte < 5000[eenheden/m] && breedte < 5000[eenheden/m] && in_NL;

				unit<uint32> selectie := select_with_attr_by_org_rel(src, geen_zeer_grote_panden_in_NL);
			}
			container overig_filter
			{
				attribute<bool> in_selectie (src):= switch(
					 case(  met_geo_sel &&  met_vreemde_waarden_sel,  afgeleid/geo_selectie/result && vreemde_waarden_filter/geen_zeer_grote_panden_in_NL)
					,case(  met_geo_sel && !met_vreemde_waarden_sel,  afgeleid/geo_selectie/result )
					,case( !met_geo_sel &&  met_vreemde_waarden_sel,  vreemde_waarden_filter/geen_zeer_grote_panden_in_NL )
					,const(True, src)
					);
			}
			container impl :=
				='datum_conditie(src, prik_datum, src/meta/BEGINDATUM, src/meta/EINDDATUM, afgeleid/status/status_sel, '+ ((met_geo_sel || met_vreemde_waarden_sel)
						? 'True,  overig_filter/in_selectie'
						: 'False'
					)
				+ ')'
			;

			unit<uint32> selectie := select_with_attr_by_org_rel(src, impl/conditie)
			, DialogType = "Map"
			, DialogData = "geometry_m"
			{
				container meta := collect_attr_by_org_rel(src/meta, selectie, org_rel);
				attribute<Classifications/status/pand> status_rel := afgeleid/status/status_rel[org_rel];
				attribute<Geography/rdc> geometry_m (polygon) := afgeleid/geometry[org_rel];
				attribute<result> result_rel := rlookup(identificatie, result/identificatie);
				attribute<uint64> sleutel    := uint64(result_rel) * voorkomen_factor + uint64(meta/VOORKOMENIDENTIFICATIE);
			}

			unit<uint32> result_base := unique(selectie/identificatie);

			unit<uint32> phn := result
			{
				attribute<eenheden/cm_uint16> AHN_hoogte    := afleidingen/pand_attributen/hoogte/AHN_hoogte;
				attribute<uint16>             AHN_inwinjaar := afleidingen/pand_attributen/hoogte/AHN_inwinjaar;
			}

			unit<uint32> result :=  TiledUnit(1000000[result_base])
			, DialogType  = "Map"
			, DialogData  = "geometry"
			{
				attribute<uint32>         vbo_count             := pcount(vbo/result/pand_rel)      , DisableStorage = "True";
				attribute<selectie>       keuze                 := rlookup(uint64(id(.)) * voorkomen_factor + uint64(max(selectie/meta/VOORKOMENIDENTIFICATIE, selectie/result_rel)), selectie/sleutel), DisableStorage = "True";

				attribute<uint64>         identificatie         := result_base/values[mapping(result, result_base)];
				attribute<Geography/rdc> geometry    (polygon) := selectie/geometry_m[keuze];
				attribute<eenheden/jaar>  bouwjaar              := selectie/oorspronkelijkBouwjaar[keuze][eenheden/jaar];

				container woningtype
				{
					attribute<uint32>                                              nr_buurpanden  (..) := afleidingen/pand_attributen/geometrie/results/nr_buurpanden;
					attribute<afleidingen/pand_attributen/geometrie/type_woonpand> WOONPAND_TYPE  (..) := afleidingen/pand_attributen/geometrie/results/type_woonpand_rel;
				}

				container meta := meta_template(selectie, ., Classifications/status/pand);

				container gebruiksdoelen:=
					for_each_nedv(
						'nr_'+ Classifications/gebruiksdoel_vbo/name
						, 'sum(vbo/result/gebruiksdoelen/' + Classifications/gebruiksdoel_vbo/name + ' ? 1 : 0 , vbo/result/pand_rel)'
						, result
						, uint32
					);
			}
		}

		container vbo
		{
			unit<uint32> src
			: StorageName     = "= StoreDir + '/vbo.mmd'"
			, StorageReadOnly = "True"
			{
			}

			container afgeleid
			{
				attribute<Geography/rdc> geometry (src) := src/geometry[Geography/rdc], Descr = "Het BAG-punt, of bij een vbo met een vlak een punt binnen dat vlak; Xml2MMD legt dat al zo vast.";
				container status := status_selectie(src, Classifications/status/vbo, src/status, src/status/Label, src/meta/status_rel);
				attribute<bool> geo_selectie (src) := isDefined(point_in_polygon(geometry, /geo_selectie/Geometry));
			}

			container impl :=
				='datum_conditie(src, prik_datum, src/meta/BEGINDATUM, src/meta/EINDDATUM, afgeleid/status/status_sel, ' + (met_geo_sel
						? 'True,  afgeleid/geo_selectie'
						: 'False'
					)
				+ ')'
			;

			unit<uint32> selectie := select_with_attr_by_org_rel(src, impl/conditie)
			, DialogType = "Map"
			, DialogData = "geometry_in_nl"
			{
				container meta := collect_attr_by_org_rel(src/meta, selectie, org_rel);
				attribute<Classifications/status/vbo> status_rel := afgeleid/status/status_rel[org_rel];
				attribute<Geography/rdc> geometry_m := afgeleid/geometry[org_rel];
				attribute<float64> X := PointCol(geometry_m);
				attribute<float64> Y := PointRow(geometry_m);
				// Op snapshot moment willen we alleen geometrien in NL (https://nl.wikipedia.org/wiki/Rijksdriehoeksco%C3%B6rdinaten), dit ten behoeve van gemiddelde bepalingen (denk aan coordinaten voor geocode)
				attribute<Geography/rdc> geometry_in_nl :=
					   X >=  -8000d &&  X <= 300000d
					&& Y >= 289000d &&  Y <= 629000d
						? geometry_m
						: point_xy(0d/0d, 0d/0d, Geography/rdc);

				attribute<result> result_rel := rlookup(identificatie, result/identificatie);
				attribute<uint64> sleutel    := uint64(result_rel) * voorkomen_factor + uint64(meta/VOORKOMENIDENTIFICATIE);

				container gebruiksdoelen := collect_attr_by_org_rel(src/gebruiksdoelen, selectie, org_rel);
			}

			unit<uint32> result_base := unique(selectie/identificatie);

			unit<uint32> result := TiledUnit(1000000[result_base])
			,	DialogType  = "Map"
			,	DialogData  = "geometry"
			{
				attribute<uint32>         count               := pcount(selectie/result_rel), DisableStorage = "True";
				attribute<selectie>       keuze               := rlookup(uint64(id(.)) * voorkomen_factor + uint64(max(selectie/meta/VOORKOMENIDENTIFICATIE, selectie/result_rel)), selectie/sleutel), DisableStorage = "True";

				attribute<uint64>         identificatie       := result_base/values[mapping(result, result_base)];
				attribute<Geography/rdc> geometry            := selectie/geometry_in_nl[keuze];
				attribute<int32>          oppervlakte         := selectie/oppervlakte[keuze];
				attribute<uint64>         nummeraanduiding_id := selectie/nummeraanduiding_id[keuze];

				// Het pand van een vbo is zijn eigen pandverwijzing in de BAG (bij meer gerelateerde panden de
				// laatste; gerelateerdPand bevat ze allemaal), niet het pand waarin zijn punt ligt. Dit item neemt
				// alle statussen mee, dus een punt ligt vaak in meer panden tegelijk: een gesloopt, niet
				// gerealiseerd of ten onrechte opgevoerd pand en zijn opvolger. Welke daarvan point_in_polygon
				// teruggeeft is niet vastgelegd en verschilt tussen GeoDMS-versies (GeoDMS #1289).
				attribute<uint64>         pand_id             := last(gerelateerdPand/pand_id, gerelateerdPand/result_rel);
				attribute<pand/result>    pand_rel            := rlookup(pand_id, pand/result/identificatie), DisableStorage = "True";
				// het pand waarin het punt van de vbo ligt, alleen ter controle (overzichten, export)
				attribute<pand/result>    pand_rel_geom       := point_in_polygon(geometry, pand/result/geometry), DisableStorage = "True";
				attribute<uint64>         pand_id_geom        := pand/result/identificatie[pand_rel_geom];

				container gebruiksdoelen:=
					for_each_nedv(
						Classifications/gebruiksdoel_vbo/name
						, 'selectie/gebruiksdoelen/' + Classifications/gebruiksdoel_vbo/name + '[keuze]'
						, result
						, bool
					);

				container meta := meta_template(selectie, ., Classifications/status/vbo);

				// de relaties vbo-pand van de geselecteerde voorkomens; result_rel is gevuld voor de relaties van het gekozen voorkomen
				unit<uint32> gerelateerdPand := select_with_attr_by_cond(src/gerelateerdPand, IsDefined(rlookup(src/gerelateerdPand/vbo_rel, selectie/org_rel))), DisableStorage = "True"
				{
					attribute<uint64> identificatie := src/identificatie[vbo_rel];
					attribute<result> result_rel    := rlookup(vbo_rel, selectie/org_rel[keuze]), DisableStorage = "True";
				}

				unit<uint32> nevenadres := select_with_attr_by_cond(src/nevenadres, IsDefined(rlookup(src/nevenadres/vbo_rel, selectie/org_rel))) // is een 1->0..n relatie
				{
					attribute<uint64> identificatie := src/identificatie[vbo_rel];
				}
			}
		}

		container nummeraanduiding
		{
			unit<uint32> src
			:	StorageName     = "= StoreDir + '/nummeraanduiding.mmd'"
			,	StorageReadOnly = "True"
			{
			}

			container afgeleid
			{
				container status := status_selectie(src, Classifications/status/nummeraanduiding, src/status, src/status/Label, src/meta/status_rel);
				attribute<bool> OpenbareruimteInSelectie (src) := isDefined(rlookup(src/openbareruimte_id, openbareruimte/result/identificatie));
				// de koppeling loopt over de labeltekst en niet over de volgorde van de codes
				attribute<Classifications/typeAdresseerbaarObject> type_code (src/typeAdresseerbaarObject) := rlookup(lowercase(src/typeAdresseerbaarObject/Label), lowercase(Classifications/typeAdresseerbaarObject/label));
			}

			container impl:=
				='datum_conditie(src, prik_datum, src/meta/BEGINDATUM, src/meta/EINDDATUM, afgeleid/status/status_sel, ' + (met_geo_sel
						? 'True,  afgeleid/OpenbareruimteInSelectie'
						: 'False'
					)
				+ ')'
			;

			unit<uint32> selectie := select_with_attr_by_org_rel(src, impl/conditie)
			{
				container meta := collect_attr_by_org_rel(src/meta, selectie, org_rel);
				attribute<Classifications/status/nummeraanduiding> status_rel := afgeleid/status/status_rel[org_rel];
				attribute<result> result_rel := rlookup(identificatie, result/identificatie);
				attribute<uint64> sleutel    := uint64(result_rel) * voorkomen_factor + uint64(meta/VOORKOMENIDENTIFICATIE);
			}

			unit<uint32> result_base := unique(selectie/identificatie);

			unit<uint32> result := TiledUnit(1000000[result_base])
			{
				attribute<uint32>   count := pcount(selectie/result_rel), DisableStorage = "True";
				attribute<selectie> keuze := rlookup(uint64(id(.)) * voorkomen_factor + uint64(max(selectie/meta/VOORKOMENIDENTIFICATIE, selectie/result_rel)), selectie/sleutel), DisableStorage = "True";

				attribute<uint64> identificatie               := result_base/values[mapping(result, result_base)];
				attribute<int32>  huisnummer                  := selectie/huisnummer[keuze];
				attribute<string> huisletter                  := selectie/huisletter[keuze];
				attribute<string> toevoeging                  := selectie/toevoeging[keuze];
				attribute<string> postcode                    := selectie/postcode[keuze];
				attribute<Classifications/typeAdresseerbaarObject> typeAdresseerbaarObject_rel := afgeleid/type_code[selectie/typeAdresseerbaarObject_rel[keuze]];
				attribute<uint64> openbareruimte_id           := selectie/openbareruimte_id[keuze];
				attribute<uint64> woonplaats_id               := selectie/woonplaats_id[keuze];

				container meta := meta_template(selectie, ., Classifications/status/nummeraanduiding);
			}
		}

		container openbareruimte
		{
			unit<uint32> src
			: StorageName     = "= StoreDir + '/openbareruimte.mmd'"
			, StorageReadOnly = "True"
			{
			}

			container afgeleid
			{
				container status := status_selectie(src, Classifications/status/openbareruimte, src/status, src/status/Label, src/meta/status_rel);
				attribute<bool> Woonplaatsgeo_selectie (src) := isDefined(rlookup(src/woonplaats_id, woonplaats/result/identificatie));
				attribute<Classifications/openbareruimte_type> type_code (src/type) := rlookup(lowercase(src/type/Label), lowercase(Classifications/openbareruimte_type/label));
			}

			container impl :=
				='datum_conditie(src, prik_datum, src/meta/BEGINDATUM, src/meta/EINDDATUM, afgeleid/status/status_sel, ' + (met_geo_sel
						? 'True,  afgeleid/Woonplaatsgeo_selectie'
						: 'False'
					)
				+ ')'
			;

			unit<uint32> selectie := select_with_attr_by_org_rel(src, impl/conditie)
			{
				container meta := collect_attr_by_org_rel(src/meta, selectie, org_rel);
				attribute<Classifications/status/openbareruimte> status_rel := afgeleid/status/status_rel[org_rel];
				attribute<result> result_rel := rlookup(identificatie, result/values);
				attribute<uint64> sleutel    := uint64(result_rel) * voorkomen_factor + uint64(meta/VOORKOMENIDENTIFICATIE);
			}

			unit<uint32> result := unique(selectie/identificatie)
			{
				attribute<uint32>   count  := pcount(selectie/result_rel), DisableStorage = "True";
				attribute<selectie> keuze  := rlookup(uint64(id(.)) * voorkomen_factor + uint64(max(selectie/meta/VOORKOMENIDENTIFICATIE, selectie/result_rel)), selectie/sleutel), DisableStorage = "True";
				attribute<uint64>   values : DisableStorage = "True";

				attribute<uint64> identificatie := values;
				attribute<string> naam          := selectie/naam[keuze];
				attribute<Classifications/openbareruimte_type> type_rel := afgeleid/type_code[selectie/type_rel[keuze]];
				attribute<uint64> woonplaats_id := selectie/woonplaats_id[keuze];
				container meta := meta_template(selectie, ., Classifications/status/openbareruimte);
			}
		}

		container woonplaats
		{
			unit<uint32> src
			:	StorageName     = "= StoreDir + '/woonplaats.mmd'"
			,	StorageReadOnly = "True"
			{
			}

			container afgeleid
			{
				attribute<Geography/rdc> geometry (src, polygon) := src/geometry[Geography/rdc];
				container status       := status_selectie(src, Classifications/status/woonplaats, src/status, src/status/Label, src/meta/status_rel);
				container geo_selectie := = met_geo_sel
					? 'polygon_selectie(src, afgeleid/geometry)'
					: 'nl_selectie(src)';
			}

			container impl :=
				='datum_conditie(src, prik_datum, src/meta/BEGINDATUM, src/meta/EINDDATUM, afgeleid/status/status_sel, ' + (met_geo_sel
						? 'True,  afgeleid/geo_selectie/result'
						: 'False'
					)
				+ ')'
			;

			unit<uint32> selectie := select_with_attr_by_org_rel(src, impl/conditie)
			, DialogType = "Map"
			, DialogData = "geometry_m"
			{
				container meta := collect_attr_by_org_rel(src/meta, selectie, org_rel);
				attribute<Classifications/status/woonplaats> status_rel := afgeleid/status/status_rel[org_rel];
				attribute<Geography/rdc> geometry_m (polygon) := afgeleid/geometry[org_rel];
				attribute<result> result_rel := rlookup(identificatie, result/values);
				attribute<uint64> sleutel    := uint64(result_rel) * voorkomen_factor + uint64(meta/VOORKOMENIDENTIFICATIE);
			}
			unit<uint32> result := unique(selectie/identificatie)
			{
				attribute<uint32>   count  := pcount(selectie/result_rel), DisableStorage = "True";
				attribute<selectie> keuze  := rlookup(uint64(id(.)) * voorkomen_factor + uint64(max(selectie/meta/VOORKOMENIDENTIFICATIE, selectie/result_rel)), selectie/sleutel), DisableStorage = "True";
				attribute<uint64>   values : DisableStorage = "True";

				attribute<Geography/rdc> geometry    (polygon) := selectie/geometry_m[keuze];
				attribute<uint64>         identificatie         := values;
				attribute<string>         woonplaatsNaam        := selectie/woonplaatsNaam[keuze];

				container meta := meta_template(selectie, ., Classifications/status/woonplaats);
			}
		}
		#include<afleidingen.dms>
		#include<overzichten.dms>
	}

	// De hele snapshot in een MMD store. Verwijzingen tussen de objecttypes zijn relaties in plaats van
	// sleutels, en de codelijsten reizen zelfbeschrijvend mee. Een sleutel die met lookup(A/B_rel,
	// B/identificatie) terug te halen is, wordt niet bewaard.
	container snapshot_store
	:	StorageName = "= SnapshotDir + '/bag.mmd'"
	{
			// ---- classificaties, eenmalig en zelfbeschrijvend in de store
			unit<uint8> status_ligplaats := Classifications/status/ligplaats
			{
				attribute<string> Label    := Classifications/status/ligplaats/label, DialogType = "LabelText";
				attribute<bool>   selected := Classifications/status/ligplaats/selected;
			}
			// standplaats deelt de codelijst van ligplaats (zie Classifications: standplaats := ligplaats),
			// dus standplaats/meta/status_rel verwijst hieronder naar status_ligplaats.
			unit<uint8> status_pand := Classifications/status/pand
			{
				attribute<string> Label    := Classifications/status/pand/label, DialogType = "LabelText";
				attribute<bool>   selected := Classifications/status/pand/selected;
			}
			unit<uint8> status_vbo := Classifications/status/vbo
			{
				attribute<string> Label    := Classifications/status/vbo/label, DialogType = "LabelText";
				attribute<bool>   selected := Classifications/status/vbo/selected;
			}
			unit<uint8> status_nummeraanduiding := Classifications/status/nummeraanduiding
			{
				attribute<string> Label    := Classifications/status/nummeraanduiding/label, DialogType = "LabelText";
				attribute<bool>   selected := Classifications/status/nummeraanduiding/selected;
			}
			unit<uint8> status_openbareruimte := Classifications/status/openbareruimte
			{
				attribute<string> Label    := Classifications/status/openbareruimte/label, DialogType = "LabelText";
				attribute<bool>   selected := Classifications/status/openbareruimte/selected;
			}
			unit<uint8> status_woonplaats := Classifications/status/woonplaats
			{
				attribute<string> Label    := Classifications/status/woonplaats/label, DialogType = "LabelText";
				attribute<bool>   selected := Classifications/status/woonplaats/selected;
			}
			unit<uint8> typeAdresseerbaarObject := Classifications/typeAdresseerbaarObject
			{
				attribute<string> Label := Classifications/typeAdresseerbaarObject/label, DialogType = "LabelText";
			}
			unit<uint8> type_openbareruimte := Classifications/openbareruimte_type
			{
				attribute<string> Label := Classifications/openbareruimte_type/label, DialogType = "LabelText";
			}
			unit<uint8> type_woonpand := object/afleidingen/pand_attributen/geometrie/type_woonpand
			{
				attribute<string> Label      := object/afleidingen/pand_attributen/geometrie/type_woonpand/label,      DialogType = "LabelText";
				attribute<string> name       := object/afleidingen/pand_attributen/geometrie/type_woonpand/name;
				attribute<uint32> BrushColor := object/afleidingen/pand_attributen/geometrie/type_woonpand/BrushColor, DialogType = "BrushColor";
				attribute<uint32> PenColor   := BrushColor,    DialogType = "PenColor";
			}

			// ---- objecttypes, in volgorde van verwijzing
			unit<uint32> woonplaats := object/woonplaats/result
			{
				attribute<Geography/rdc> geometry (polygon) := object/woonplaats/result/geometry;
				attribute<uint64>         identificatie      := object/woonplaats/result/identificatie;
				attribute<string>         woonplaatsNaam     := object/woonplaats/result/woonplaatsNaam;

				container meta
				{
					attribute<status_woonplaats> status_rel             (woonplaats) := value(object/woonplaats/result/meta/status_rel, status_woonplaats);
					attribute<eenheden/datum>    BEGINDATUM             (woonplaats) := object/woonplaats/result/meta/BEGINDATUM;
					attribute<eenheden/datum>    EINDDATUM              (woonplaats) := object/woonplaats/result/meta/EINDDATUM;
					attribute<uint32>            VOORKOMENIDENTIFICATIE (woonplaats) := object/woonplaats/result/meta/VOORKOMENIDENTIFICATIE;
					attribute<eenheden/datum>    TIJDSTIPREGISTRATIE    (woonplaats) := object/woonplaats/result/meta/TIJDSTIPREGISTRATIE;
					attribute<eenheden/datum>    EINDREGISTRATIE        (woonplaats) := object/woonplaats/result/meta/EINDREGISTRATIE;
					attribute<eenheden/datum>    DOCUMENTDATUM          (woonplaats) := object/woonplaats/result/meta/DOCUMENTDATUM;
					attribute<string>            DOCUMENTNUMMER         (woonplaats) := object/woonplaats/result/meta/DOCUMENTNUMMER;
					attribute<bool>              IS_GECONSTATEERD       (woonplaats) := object/woonplaats/result/meta/IS_GECONSTATEERD;
				}
			}

			unit<uint32> openbareruimte := object/openbareruimte/result
			{
				attribute<uint64>              identificatie  := object/openbareruimte/result/identificatie;
				attribute<string>              naam           := object/openbareruimte/result/naam;
				attribute<type_openbareruimte> type_rel       := value(object/openbareruimte/result/type_rel, type_openbareruimte);
				attribute<woonplaats>          woonplaats_rel := rlookup(object/openbareruimte/result/woonplaats_id, woonplaats/identificatie);

				container meta
				{
					attribute<status_openbareruimte> status_rel             (openbareruimte) := value(object/openbareruimte/result/meta/status_rel, status_openbareruimte);
					attribute<eenheden/datum>        BEGINDATUM             (openbareruimte) := object/openbareruimte/result/meta/BEGINDATUM;
					attribute<eenheden/datum>        EINDDATUM              (openbareruimte) := object/openbareruimte/result/meta/EINDDATUM;
					attribute<uint32>                VOORKOMENIDENTIFICATIE (openbareruimte) := object/openbareruimte/result/meta/VOORKOMENIDENTIFICATIE;
					attribute<eenheden/datum>        TIJDSTIPREGISTRATIE    (openbareruimte) := object/openbareruimte/result/meta/TIJDSTIPREGISTRATIE;
					attribute<eenheden/datum>        EINDREGISTRATIE        (openbareruimte) := object/openbareruimte/result/meta/EINDREGISTRATIE;
					attribute<eenheden/datum>        DOCUMENTDATUM          (openbareruimte) := object/openbareruimte/result/meta/DOCUMENTDATUM;
					attribute<string>                DOCUMENTNUMMER         (openbareruimte) := object/openbareruimte/result/meta/DOCUMENTNUMMER;
					attribute<bool>                  IS_GECONSTATEERD       (openbareruimte) := object/openbareruimte/result/meta/IS_GECONSTATEERD;
				}
			}

			unit<uint32> nummeraanduiding := object/nummeraanduiding/result
			{
				attribute<uint64>                  identificatie               := object/nummeraanduiding/result/identificatie;
				attribute<int32>                   huisnummer                  := object/nummeraanduiding/result/huisnummer;
				attribute<string>                  huisletter                  := object/nummeraanduiding/result/huisletter;
				attribute<string>                  toevoeging                  := object/nummeraanduiding/result/toevoeging;
				attribute<string>                  postcode                    := object/nummeraanduiding/result/postcode;
				attribute<typeAdresseerbaarObject> typeAdresseerbaarObject_rel := value(object/nummeraanduiding/result/typeAdresseerbaarObject_rel, typeAdresseerbaarObject);
				attribute<openbareruimte>          openbareruimte_rel          := rlookup(object/nummeraanduiding/result/openbareruimte_id, openbareruimte/identificatie);
				attribute<woonplaats>              woonplaats_rel              := rlookup(object/nummeraanduiding/result/woonplaats_id, woonplaats/identificatie);

				// het adres zelf: de geometrie van het bijbehorende object en de namen die daarbij horen
				attribute<Geography/rdc>     geometry               := object/afleidingen/adres/geometry;
				attribute<float64>            X                      := object/afleidingen/adres/X;
				attribute<float64>            Y                      := object/afleidingen/adres/Y;
				attribute<string>             straatnaam             := object/afleidingen/adres/straatnaam;
				attribute<string>             woonplaatsnaam         := object/afleidingen/adres/woonplaatsnaam;

				container meta
				{
					attribute<status_nummeraanduiding> status_rel             (nummeraanduiding) := value(object/nummeraanduiding/result/meta/status_rel, status_nummeraanduiding);
					attribute<eenheden/datum>          BEGINDATUM             (nummeraanduiding) := object/nummeraanduiding/result/meta/BEGINDATUM;
					attribute<eenheden/datum>          EINDDATUM              (nummeraanduiding) := object/nummeraanduiding/result/meta/EINDDATUM;
					attribute<uint32>                  VOORKOMENIDENTIFICATIE (nummeraanduiding) := object/nummeraanduiding/result/meta/VOORKOMENIDENTIFICATIE;
					attribute<eenheden/datum>          TIJDSTIPREGISTRATIE    (nummeraanduiding) := object/nummeraanduiding/result/meta/TIJDSTIPREGISTRATIE;
					attribute<eenheden/datum>          EINDREGISTRATIE        (nummeraanduiding) := object/nummeraanduiding/result/meta/EINDREGISTRATIE;
					attribute<eenheden/datum>          DOCUMENTDATUM          (nummeraanduiding) := object/nummeraanduiding/result/meta/DOCUMENTDATUM;
					attribute<string>                  DOCUMENTNUMMER         (nummeraanduiding) := object/nummeraanduiding/result/meta/DOCUMENTNUMMER;
					attribute<bool>                    IS_GECONSTATEERD       (nummeraanduiding) := object/nummeraanduiding/result/meta/IS_GECONSTATEERD;
				}
			}

			// Ligplaatsen liggen in het water: een lichtblauwe vulling met een donkerblauwe rand.
			// De stijl en de map-aanwijzing reizen in de dictionary mee (GeoDMS 20.21.0, issue
			// ObjectVision/GeoDMS#1275), dus een lezer ziet in de Layer Control welke kleur bij
			// welke laag hoort (issue #5).
			unit<uint32> ligplaats := object/ligplaats/result, DialogType = "Map", DialogData = "geometry"
			{
				attribute<Geography/rdc>   geometry (polygon)   := object/ligplaats/result/geometry;
				attribute<uint64>           identificatie        := object/ligplaats/result/identificatie;
				attribute<nummeraanduiding> nummeraanduiding_rel := rlookup(object/ligplaats/result/nummeraanduiding_id, nummeraanduiding/identificatie);

				parameter<uint32> BrushColor := rgb(153,204,255), DialogType = "BrushColor";
				parameter<uint32> PenColor   := rgb(  0, 90,160), DialogType = "PenColor";
				// het label van een ligplaats in kaart en tabel is zijn identificatie; als regel in de
				// dictionary, de store bewaart er geen bytes voor
				attribute<string> Label := string(identificatie), DialogType = "LabelText";

				container meta
				{
					attribute<status_ligplaats> status_rel             (ligplaats) := value(object/ligplaats/result/meta/status_rel, status_ligplaats);
					attribute<eenheden/datum>   BEGINDATUM             (ligplaats) := object/ligplaats/result/meta/BEGINDATUM;
					attribute<eenheden/datum>   EINDDATUM              (ligplaats) := object/ligplaats/result/meta/EINDDATUM;
					attribute<uint32>           VOORKOMENIDENTIFICATIE (ligplaats) := object/ligplaats/result/meta/VOORKOMENIDENTIFICATIE;
					attribute<eenheden/datum>   TIJDSTIPREGISTRATIE    (ligplaats) := object/ligplaats/result/meta/TIJDSTIPREGISTRATIE;
					attribute<eenheden/datum>   EINDREGISTRATIE        (ligplaats) := object/ligplaats/result/meta/EINDREGISTRATIE;
					attribute<eenheden/datum>   DOCUMENTDATUM          (ligplaats) := object/ligplaats/result/meta/DOCUMENTDATUM;
					attribute<string>           DOCUMENTNUMMER         (ligplaats) := object/ligplaats/result/meta/DOCUMENTNUMMER;
					attribute<bool>             IS_GECONSTATEERD       (ligplaats) := object/ligplaats/result/meta/IS_GECONSTATEERD;
				}

				unit<uint32> nevenadres := object/ligplaats/result/nevenadres
				{
					attribute<ligplaats>        ligplaats_rel        := rlookup(object/ligplaats/result/nevenadres/identificatie, ligplaats/identificatie);
					attribute<nummeraanduiding> nummeraanduiding_rel := rlookup(object/ligplaats/result/nevenadres/nummeraanduiding_id, nummeraanduiding/identificatie);
				}
			}

			// Standplaatsen liggen op het land: een zandkleurige vulling met een bruine rand, zie ligplaats.
			unit<uint32> standplaats := object/standplaats/result, DialogType = "Map", DialogData = "geometry"
			{
				attribute<Geography/rdc>   geometry (polygon)   := object/standplaats/result/geometry;
				attribute<uint64>           identificatie        := object/standplaats/result/identificatie;
				attribute<nummeraanduiding> nummeraanduiding_rel := rlookup(object/standplaats/result/nummeraanduiding_id, nummeraanduiding/identificatie);

				parameter<uint32> BrushColor := rgb(222,184,135), DialogType = "BrushColor";
				parameter<uint32> PenColor   := rgb(139, 90, 43), DialogType = "PenColor";
				attribute<string> Label      := string(identificatie), DialogType = "LabelText"; // zie ligplaats

				container meta
				{
					attribute<status_ligplaats> status_rel             (standplaats) := value(object/standplaats/result/meta/status_rel, status_ligplaats);
					attribute<eenheden/datum>   BEGINDATUM             (standplaats) := object/standplaats/result/meta/BEGINDATUM;
					attribute<eenheden/datum>   EINDDATUM              (standplaats) := object/standplaats/result/meta/EINDDATUM;
					attribute<uint32>           VOORKOMENIDENTIFICATIE (standplaats) := object/standplaats/result/meta/VOORKOMENIDENTIFICATIE;
					attribute<eenheden/datum>   TIJDSTIPREGISTRATIE    (standplaats) := object/standplaats/result/meta/TIJDSTIPREGISTRATIE;
					attribute<eenheden/datum>   EINDREGISTRATIE        (standplaats) := object/standplaats/result/meta/EINDREGISTRATIE;
					attribute<eenheden/datum>   DOCUMENTDATUM          (standplaats) := object/standplaats/result/meta/DOCUMENTDATUM;
					attribute<string>           DOCUMENTNUMMER         (standplaats) := object/standplaats/result/meta/DOCUMENTNUMMER;
					attribute<bool>             IS_GECONSTATEERD       (standplaats) := object/standplaats/result/meta/IS_GECONSTATEERD;
				}

				unit<uint32> nevenadres := object/standplaats/result/nevenadres
				{
					attribute<standplaats>      standplaats_rel      := rlookup(object/standplaats/result/nevenadres/identificatie, standplaats/identificatie);
					attribute<nummeraanduiding> nummeraanduiding_rel := rlookup(object/standplaats/result/nevenadres/nummeraanduiding_id, nummeraanduiding/identificatie);
				}
			}

			unit<uint32> pand := object/pand/result
			{
				attribute<Geography/rdc> geometry (polygon) := object/pand/result/geometry;
				attribute<uint64>         identificatie      := object/pand/result/identificatie;
				attribute<eenheden/jaar>  bouwjaar           := object/pand/result/bouwjaar;
				attribute<type_woonpand>  woonpand_type_rel  := object/pand/result/woningtype/WOONPAND_TYPE[type_woonpand];

				container meta
				{
					attribute<status_pand>    status_rel             (pand) := value(object/pand/result/meta/status_rel, status_pand);
					attribute<eenheden/datum> BEGINDATUM             (pand) := object/pand/result/meta/BEGINDATUM;
					attribute<eenheden/datum> EINDDATUM              (pand) := object/pand/result/meta/EINDDATUM;
					attribute<uint32>         VOORKOMENIDENTIFICATIE (pand) := object/pand/result/meta/VOORKOMENIDENTIFICATIE;
					attribute<eenheden/datum> TIJDSTIPREGISTRATIE    (pand) := object/pand/result/meta/TIJDSTIPREGISTRATIE;
					attribute<eenheden/datum> EINDREGISTRATIE        (pand) := object/pand/result/meta/EINDREGISTRATIE;
					attribute<eenheden/datum> DOCUMENTDATUM          (pand) := object/pand/result/meta/DOCUMENTDATUM;
					attribute<string>         DOCUMENTNUMMER         (pand) := object/pand/result/meta/DOCUMENTNUMMER;
					attribute<bool>           IS_GECONSTATEERD       (pand) := object/pand/result/meta/IS_GECONSTATEERD;
				}

				container gebruiksdoelen := for_each_nedv(
					  'nr_' + Classifications/gebruiksdoel_vbo/name
					, 'object/pand/result/gebruiksdoelen/nr_' + Classifications/gebruiksdoel_vbo/name
					, pand
					, uint32);
			}

			unit<uint32> vbo := object/vbo/result
			{
				attribute<Geography/rdc>   geometry             := object/vbo/result/geometry;
				attribute<uint64>           identificatie        := object/vbo/result/identificatie;
				attribute<int32>            oppervlakte          := object/vbo/result/oppervlakte;
				attribute<nummeraanduiding> nummeraanduiding_rel := rlookup(object/vbo/result/nummeraanduiding_id, nummeraanduiding/identificatie);
				attribute<pand>             pand_rel             := object/vbo/result/pand_rel[pand]; // het pand waarnaar de vbo verwijst

				container meta
				{
					attribute<status_vbo>     status_rel             (vbo) := value(object/vbo/result/meta/status_rel, status_vbo);
					attribute<eenheden/datum> BEGINDATUM             (vbo) := object/vbo/result/meta/BEGINDATUM;
					attribute<eenheden/datum> EINDDATUM              (vbo) := object/vbo/result/meta/EINDDATUM;
					attribute<uint32>         VOORKOMENIDENTIFICATIE (vbo) := object/vbo/result/meta/VOORKOMENIDENTIFICATIE;
					attribute<eenheden/datum> TIJDSTIPREGISTRATIE    (vbo) := object/vbo/result/meta/TIJDSTIPREGISTRATIE;
					attribute<eenheden/datum> EINDREGISTRATIE        (vbo) := object/vbo/result/meta/EINDREGISTRATIE;
					attribute<eenheden/datum> DOCUMENTDATUM          (vbo) := object/vbo/result/meta/DOCUMENTDATUM;
					attribute<string>         DOCUMENTNUMMER         (vbo) := object/vbo/result/meta/DOCUMENTNUMMER;
					attribute<bool>           IS_GECONSTATEERD       (vbo) := object/vbo/result/meta/IS_GECONSTATEERD;
				}

				container gebruiksdoelen := for_each_nedv(
					  Classifications/gebruiksdoel_vbo/name
					, 'object/vbo/result/gebruiksdoelen/' + Classifications/gebruiksdoel_vbo/name
					, vbo
					, bool);

				unit<uint32> gerelateerdPand := object/vbo/result/gerelateerdPand // administratieve relatie uit de BAG
				{
					attribute<vbo>  vbo_rel  := rlookup(object/vbo/result/gerelateerdPand/identificatie, vbo/identificatie);
					attribute<pand> pand_rel := rlookup(object/vbo/result/gerelateerdPand/pand_id, pand/identificatie);
				}

				unit<uint32> nevenadres := object/vbo/result/nevenadres
				{
					attribute<vbo>              vbo_rel              := rlookup(object/vbo/result/nevenadres/identificatie, vbo/identificatie);
					attribute<nummeraanduiding> nummeraanduiding_rel := rlookup(object/vbo/result/nevenadres/nummeraanduiding_id, nummeraanduiding/identificatie);
				}
			}

			// Een aparte adressentabel is er niet meer: die was dezelfde domein-eenheid als
			// nummeraanduiding, met dezelfde postcode, huisnummer, huisletter en toevoeging.
	}

	// De PHN-hoogte is optioneel en heeft eigen brondata, dus die blijft een eigen store,
	// rij voor rij uitgelijnd met snapshot_store/pand.
	unit<uint32> pandhoogte_store := object/pand/result
	,	StorageName = "= SnapshotDir + '/pandhoogte.mmd'"
	{
		attribute<eenheden/cm_uint16> AHN_hoogte    := object/afleidingen/pand_attributen/hoogte/AHN_hoogte;
