////////////////////////////////////////////////////////////////////////////////////////
//                                                                                    //
//                                                                                    //
//              Configuratie voor project: BAG 2.0 MMD stores > snapshot              //
//                                                                                    //
//                              Object Vision 2023                                    //
//                                                                                    //
////////////////////////////////////////////////////////////////////////////////////////
//                                                                                    //
// Template die de resultaten per BAG Objecttype verzamelt, selecteert en wegschrijft //
//                                                                                    //
////////////////////////////////////////////////////////////////////////////////////////

template MakeSnapshot
{
	// begin case parameters
	parameter<eenheden/datum> prik_datum;
	parameter<bool>           met_geo_sel;
	parameter<bool>           met_status_sel;
	parameter<bool>           met_vreemde_waarden_sel;
	parameter<bool>           met_pandhoogte_attributen;
	parameter<string>         format_export;
	// end case parameters

	parameter<string> SnapshotGeoDirPart := met_geo_sel ? geo_selectie/Label + '/' : '';
	parameter<string> SnapshotDir        := SnapshotBaseDir + '/' + SnapshotGeoDirPart + string(prik_datum) + '.new';

	parameter<bool> WriteToMMD := lowercase(format_export) = 'mmd';

	parameter<string> SuppliersExprAll := isValidStoreDir
		? 	WriteToMMD
			?
				'snapshot_store;'
				'object/overzichten/impl/genereer_rapport' 
				+ (met_pandhoogte_attributen ? ';pandhoogte_store' : '')
			: 'gdalwrite_vect_export/result/make_geopackage '
		: ''; 

	parameter<string> SuppliersExprAdres := isValidStoreDir
		?
			'snapshot_store'
		: ''; 

	parameter<string> MaakVolledigeSnapshot := isValidStoreDir ? 'ready' : 'Folder : ' + expand(., StoreDir) + ' bevat geen volledige set van MMD stores'
	,  ExplicitSuppliers = "= SuppliersExprAll";

	parameter<string> MaakAlleenAdressenTabel := isValidStoreDir ? 'ready' : 'Folder : ' + expand(., StoreDir)+ ' bevat geen volledige set van MMD stores'
	,  ExplicitSuppliers = "= SuppliersExprAdres";

	container object
	{
		container ligplaats
		{
			unit<uint32> src
			: StorageName     = "= StoreDir + '/ligplaats.mmd'"
			, StorageReadOnly = "True"
			{
			}

			// Een MMD-leesholder mag zelf niets declareren; de dictionary van de store doet dat.
			// Alles wat niet uit de store komt, staat daarom hier.
			container afgeleid
			{
				container status := status_selectie(src, typeringen/status/ligplaats, src/meta/STATUS);
				container geo_selectie := = met_geo_sel
					? 'polygon_selectie(src, src/geometry)'
					: 'nl_selectie(src)';
			}
			container impl:=
				='datum_conditie(src, prik_datum, src/meta/BEGINDATUM, src/meta/EINDDATUM, afgeleid/status/status_sel, '+ (met_geo_sel 
						? 'True,  afgeleid/geo_selectie/result'
						: 'False'
					)
				+ ')'
			;

			// De selectie hoort hier en niet in de template: een unit die als case parameter wordt
			// meegegeven draagt de sub-items van een MMD store niet mee (GeoDMS 20.19.1).
			unit<uint32> selectie := select_with_attr_by_org_rel(src, impl/conditie)
			, DialogType = "Map"
			, DialogData = "geometry"
			{
				container meta := collect_attr_by_org_rel(src/meta, selectie, org_rel);
				attribute<result> result_rel := rlookup(identificatie, result/values);
				attribute<string> key        := identificatie + '_' + string(meta/VOORKOMENIDENTIFICATIE);
			}
			unit<uint32> result := unique(selectie/identificatie)
			{
				attribute<uint32>            count                 := pcount(selectie/result_rel), DisableStorage = "True";
				attribute<geometries/rdc>    geometry    (polygon) := rjoin(key, selectie/key, selectie/geometry);

				attribute<string>            values                : DisableStorage = "True";
				attribute<string>            identificatie         := values;
				attribute<string>            key                   := identificatie + '_' + string(max(selectie/meta/VOORKOMENIDENTIFICATIE, selectie/result_rel)), DisableStorage = "True";
				
				attribute<string>            nummeraanduiding_id   := rjoin(key, selectie/key, selectie/nummeraanduiding_id);

				container meta := meta_template(selectie, .);

				unit<uint32> nevenadres := select_with_attr_by_cond(src/nevenadres, IsDefined(rlookup(src/nevenadres/mutatie_rel, selectie/org_rel))) // is een 1->0..n relatie
				{
					attribute<string> identificatie := src/identificatie[mutatie_rel];
				}
			}

		}

		container standplaats
		{
			unit<uint32> src
			: StorageName     = "= StoreDir + '/standplaats.mmd'"
			, StorageReadOnly = "True"
			{
			}

			// Een MMD-leesholder mag zelf niets declareren; de dictionary van de store doet dat.
			// Alles wat niet uit de store komt, staat daarom hier.
			container afgeleid
			{
				container status := status_selectie(src, typeringen/status/standplaats, src/meta/STATUS);
				container geo_selectie := = met_geo_sel
					? 'polygon_selectie(src, src/geometry)'
					: 'nl_selectie(src)';
			}
			container impl :=
				='datum_conditie(src, prik_datum, src/meta/BEGINDATUM, src/meta/EINDDATUM, afgeleid/status/status_sel, '+ (met_geo_sel 
						? 'True,  afgeleid/geo_selectie/result'
						: 'False'
					)
				+ ')'
			;

			// De selectie hoort hier en niet in de template: een unit die als case parameter wordt
			// meegegeven draagt de sub-items van een MMD store niet mee (GeoDMS 20.19.1).
			unit<uint32> selectie := select_with_attr_by_org_rel(src, impl/conditie)
			, DialogType = "Map"
			, DialogData = "geometry"
			{
				container meta := collect_attr_by_org_rel(src/meta, selectie, org_rel);
				attribute<result> result_rel := rlookup(identificatie, result/values);
				attribute<string> key        := identificatie + '_' + string(meta/VOORKOMENIDENTIFICATIE);
			}

			unit<uint32> result := unique(selectie/identificatie)
			{
				attribute<uint32>            count                 := pcount(selectie/result_rel), DisableStorage = "True";
				attribute<geometries/rdc>    geometry    (polygon) := rjoin(key, selectie/key, selectie/geometry);

				attribute<string>            values                : DisableStorage = "True";
				attribute<string>            identificatie         := values;
				attribute<string>            key                   := identificatie + '_' + string(max(selectie/meta/VOORKOMENIDENTIFICATIE, selectie/result_rel)), DisableStorage = "True";

				attribute<string>            nummeraanduiding_id   := rjoin(key, selectie/key, selectie/nummeraanduiding_id);

				container meta := meta_template(selectie, .);

				unit<uint32> nevenadres := select_with_attr_by_cond(src/nevenadres, IsDefined(rlookup(src/nevenadres/mutatie_rel, selectie/org_rel))) // is een 1->0..n relatie
				{
					attribute<string> identificatie := src/identificatie[mutatie_rel];
				}
			}

		}

		container pand
		{
			parameter<string> nr_stores : StorageName = "= StoreDir + '/pand/nr_stores.csv'", StorageType = "str";
			unit<uint32> fileset := range(uint32,1, uint32(nr_stores) +1);
			container Filesets   := for_each_ne(
				  'nr_' + string(id(fileset))
				, 'per_fileset(' + string(id(fileset)) + '[fileset])'
				);

			template per_fileset
			{
				// begin case parameters
				parameter<fileset> nr_fileseset;
				// end case parameters

				// Een MMD-leesholder declareert niets; de dictionary van de store bepaalt de inhoud.
				unit<uint32> store
				: StorageName     = "= StoreDir + '/pand/fs_' +  string(nr_fileseset) +'.mmd'"
				, StorageReadOnly = "True"
				{
				}
			}

			unit<uint32> src := = 'union_unit(' + asList('Filesets/nr_' +  string(id(fileset)) + '/store', ',') + ')'
			{
				attribute<geometries/rdc>    geometry      (polygon) := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/geometry', ',') + ')';
				
				attribute<geometries/rdc>    bg_simplified (polygon) := geos_simplify_multi_polygon(geometry, 1.0); // geos_simplify_polygon bestaat niet

				attribute<string>            identificatie           := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/identificatie', ',') + ')';
				attribute<eenheden/jaar>     oorspronkelijkBouwjaar  := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/oorspronkelijkBouwjaar', ',') + ')[eenheden/jaar]';

				container meta
				{
					attribute<string>                  STATUS     (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/STATUS', ',') + ')';
					attribute<typeringen/status/pand>  status_rel (src) := rlookup(lowercase(STATUS), typeringen/status/pand/label);
					attribute<bool>                    status_sel (src) := typeringen/status/pand/Selected[status_rel];

					attribute<int32 > BEGINDATUM                  (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/BEGINDATUM', ',') + ')';
					attribute<int32>  EINDDATUM                   (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/EINDDATUM', ',') + ')';

					attribute<int32>  DOCUMENTDATUM               (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/DOCUMENTDATUM', ',') + ')';
					attribute<string> DOCUMENTNUMMER              (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/DOCUMENTNUMMER', ',') + ')';

					attribute<uint32> VOORKOMENIDENTIFICATIE      (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/VOORKOMENIDENTIFICATIE', ',') + ')';

					attribute<string> TIJDSTIPREGISTRATIE         (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/TIJDSTIPREGISTRATIE', ',') + ')';
					attribute<string> EINDREGISTRATIE             (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/EINDREGISTRATIE', ',') + ')';

					attribute<bool>   IS_GECONSTATEERD            (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/IS_GECONSTATEERD', ',') + ')';
				}
				container geo_selectie  := = met_geo_sel
					? 'polygon_selectie(src, geometry)'
					: 'nl_selectie(src)';
			}
			container vreemde_waarden_filter
			{
				unit<float32>             m2                           := eenheden/m * eenheden/m;
				attribute<m2>             oppervlakte            (src) := area(src/geometry, m2);

				attribute<geometries/rdc> lower_bound            (src) := lower_bound(src/geometry);
				attribute<geometries/rdc> upper_bound            (src) := upper_bound(src/geometry);
				attribute<eenheden/m>     X_lower_bound          (src) := pointCol(lower_bound)[eenheden/m];
				attribute<eenheden/m>     X_upper_bound          (src) := pointCol(upper_bound)[eenheden/m];
				attribute<eenheden/m>     Y_lower_bound          (src) := pointRow(lower_bound)[eenheden/m];
				attribute<eenheden/m>     Y_upper_bound          (src) := pointRow(upper_bound)[eenheden/m];
				attribute<eenheden/m>     lengte                 (src) := X_upper_bound - X_lower_bound;
				attribute<eenheden/m>     breedte                (src) := Y_upper_bound - Y_lower_bound;

				attribute<geometries/rdc> centroid_or_mid        (src) := centroid_or_mid(src/geometry);
				attribute<eenheden/m>     X_centroid_or_mid      (src) := pointCol(centroid_or_mid)[eenheden/m];
				attribute<eenheden/m>     Y_centroid_or_mid      (src) := pointRow(centroid_or_mid)[eenheden/m];
				attribute<bool>           in_NL                  (src) := 
					   X_centroid_or_mid >      0[eenheden/m] && X_centroid_or_mid <= 280000[eenheden/m] 
					&& Y_centroid_or_mid > 300000[eenheden/m] && Y_centroid_or_mid <= 625000[eenheden/m];

				attribute<bool>           geen_zeer_grote_panden_in_NL (src) := oppervlakte < 100000000[m2] && lengte < 5000[eenheden/m] && breedte < 5000[eenheden/m] && in_NL;

				unit<uint32> selectie := select_with_attr_by_org_rel(src, geen_zeer_grote_panden_in_NL);
			}
			container overig_filter
			{
				attribute<bool> in_selectie (src):= switch(
					 case(  met_geo_sel &&  met_vreemde_waarden_sel,  src/geo_selectie/result && vreemde_waarden_filter/geen_zeer_grote_panden_in_NL)
					,case(  met_geo_sel && !met_vreemde_waarden_sel,  src/geo_selectie/result )
					,case( !met_geo_sel &&  met_vreemde_waarden_sel,  vreemde_waarden_filter/geen_zeer_grote_panden_in_NL )
					,const(True, src)
					);
			}
			container impl :=
				='datum_conditie(src, prik_datum, src/meta/BEGINDATUM, src/meta/EINDDATUM, src/meta/status_sel, '+ ((met_geo_sel || met_vreemde_waarden_sel)
						? 'True,  overig_filter/in_selectie'
						: 'False'
					)
				+ ')'
			;

			// De selectie hoort hier en niet in de template: een unit die als case parameter wordt
			// meegegeven draagt de sub-items van een MMD store niet mee (GeoDMS 20.19.1).
			unit<uint32> selectie := select_with_attr_by_org_rel(src, impl/conditie)
			, DialogType = "Map"
			, DialogData = "geometry"
			{
				container meta := collect_attr_by_org_rel(src/meta, selectie, org_rel);
				attribute<result> result_rel := rlookup(identificatie, result/identificatie);
				attribute<string> key        := identificatie + '_' + string(meta/VOORKOMENIDENTIFICATIE);
			}

			unit<uint32> result_base := unique(selectie/identificatie);

			unit<uint32> phn := result
			{
				attribute<eenheden/cm_uint16> AHN_hoogte    := afleidingen/pand_attributen/hoogte/AHN_hoogte;
				attribute<uint16>             AHN_inwinjaar := afleidingen/pand_attributen/hoogte/AHN_inwinjaar;
			}

			unit<uint32> result :=  TiledUnit(1000000[result_base])
			, DialogType  = "Map"
			, DialogData  = "geometry"
			{
				attribute<uint32>                                              sel_count             := pcount(selectie/result_rel) , DisableStorage = "True";
				attribute<uint32>                                              vbo_count             := pcount(vbo/result/pand_rel)      , DisableStorage = "True";
				attribute<geometries/rdc>                                      geometry    (polygon) := rjoin(identificatie, selectie/identificatie, selectie/geometry);

				attribute<string>                                              identificatie         := result_base/values[mapping(result, result_base)];
				attribute<eenheden/jaar>                                       bouwjaar              := last(selectie/oorspronkelijkBouwjaar, selectie/result_rel);

				container woningtype
				{
					attribute<uint32>                                              nr_buurpanden  (..) := afleidingen/pand_attributen/geometrie/results/nr_buurpanden;
					attribute<afleidingen/pand_attributen/geometrie/type_woonpand> WOONPAND_TYPE  (..) := afleidingen/pand_attributen/geometrie/results/type_woonpand_rel;
				}
				
				attribute<string>                                              key                       := identificatie + '_' + string(max(selectie/meta/VOORKOMENIDENTIFICATIE, selectie/result_rel)), DisableStorage = "True";

				container meta := meta_template(selectie, .);

				container gebruiksdoelen:=
					for_each_nedv(
						'nr_'+ typeringen/gebruiksdoel_vbo/name
						, 'sum(vbo/result/gebruiksdoelen/' + typeringen/gebruiksdoel_vbo/name + ' ? 1 : 0 , vbo/result/pand_rel)'
						, result
						, uint32
					);
			}


		}

		container vbo
		{
			parameter<string> nr_stores : StorageName = "= StoreDir + '/vbo/nr_stores.csv'", StorageType = "str";
			unit<uint32> fileset := range(uint32,1, uint32(nr_stores) +1);
			container Filesets   := for_each_ne(
				  'nr_' + string(id(fileset))
				, 'per_fileset(' + string(id(fileset)) + '[fileset])'
				);

			template per_fileset
			{
				// begin case parameters
				parameter<fileset> nr_fileseset;
				// end case parameters

				// Een MMD-leesholder declareert niets; de dictionary van de store bepaalt de inhoud.
				unit<uint32> store
				: StorageName     = "= StoreDir + '/vbo/fs_' +  string(nr_fileseset) +'.mmd'"
				, StorageReadOnly = "True"
				{
				}

				// De relaties naar het fileset waar een rij vandaan komt staan niet in de store.
				container afgeleid
				{
					attribute<uint32> mutatie_rel (store) := id(store);
					attribute<uint32> fileset_rel (store) := const(nr_fileseset, store);

					container gerelateerdPand
					{
						attribute<uint32> fileset_rel (store/gerelateerdPand) := const(nr_fileseset, store/gerelateerdPand);
					}
					container nevenadres
					{
						attribute<uint32> fileset_rel (store/nevenadres) := const(nr_fileseset, store/nevenadres);
					}
				}
			}

			unit<uint32> src := = 'union_unit(' + asList('Filesets/nr_' +  string(id(fileset)) + '/store', ',') + ')'
			{
				attribute<geometries/rdc>    geometry            := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/geometry', ',') + ')';
				attribute<string>            identificatie       := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/identificatie', ',') + ')';
				attribute<string>            nummeraanduiding_id := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/nummeraanduiding_id', ',') + ')';
				attribute<int32>             oppervlakte         := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/oppervlakte', ',') + ')';

				attribute<uint32>            mutatie_rel         := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/afgeleid/mutatie_rel', ',') + ')';
				attribute<uint32>            fileset_rel         := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/afgeleid/fileset_rel', ',') + ')';

				parameter<string>    gebruiksdoelen_expr         := 'union_data(src, ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/gebruiksdoelen/@@@', ',') + ')';
				parameter<string>    gebruiksdoelen_tobereplaced := '@@@';

				attribute<bool>              geo_selectie        := isDefined(point_in_polygon(geometry, /geo_selectie/Geometry));
				
				container gebruiksdoelen :=
					for_each_nedv(
						  typeringen/gebruiksdoel_vbo/name
						, '= replace(gebruiksdoelen_expr, ' + quote(gebruiksdoelen_tobereplaced) + ' ,' + quote(typeringen/gebruiksdoel_vbo/name) + ')'
						, src
						, bool
					);

				unit<uint32> polygon := = 'union_unit(' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/polygon', ',') + ')' // is een 1->0..1 relatie
				{
					attribute<geometries/rdc> geometry (polygon) := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/polygon/geometry', ',') + ')';
					attribute<string>         identificatie      := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/polygon/identificatie', ',') + ')';
					attribute<geometries/rdc> centroid           := centroid(geometry);
				}

				attribute<geometries/rdc> centroid := rjoin(identificatie, polygon/identificatie, polygon/centroid);

				unit<uint32> gerelateerdPand := = 'union_unit(' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/gerelateerdPand', ',') + ')' // is een 1->0..1 relatie
				{
					attribute<uint32> fileset_rel := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/afgeleid/gerelateerdPand/fileset_rel', ',') + ')';
					attribute<uint32> mutatie_rel := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/gerelateerdPand/mutatie_rel', ',') + ')';
					attribute<string> pand_id     := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/gerelateerdPand/pand_id ', ',') + ')';
				}

				unit<uint32> nevenadres := = 'union_unit(' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/nevenadres', ',') + ')' // is een 1->0..1 relatie
				{
					attribute<uint32> fileset_rel         := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/afgeleid/nevenadres/fileset_rel', ',') + ')';
					attribute<uint32> mutatie_rel         := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/nevenadres/mutatie_rel', ',') + ')';
					attribute<string> nummeraanduiding_id := = 'union_data(., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/nevenadres/nummeraanduiding_id ', ',') + ')';
				}

				container meta
				{
					attribute<string>                STATUS     (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/STATUS', ',') + ')';
					attribute<typeringen/status/vbo> status_rel (src) := rlookup(lowercase(STATUS), typeringen/status/vbo/label);
					attribute<bool>                  status_sel (src) := typeringen/status/vbo/Selected[status_rel];

					attribute<int32 > BEGINDATUM                (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/BEGINDATUM', ',') + ')';
					attribute<int32>  EINDDATUM                 (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/EINDDATUM', ',') + ')';

					attribute<uint32> VOORKOMENIDENTIFICATIE    (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/VOORKOMENIDENTIFICATIE', ',') + ')';
					attribute<string> TIJDSTIPREGISTRATIE       (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/TIJDSTIPREGISTRATIE', ',') + ')';
					attribute<string> EINDREGISTRATIE           (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/EINDREGISTRATIE', ',') + ')';

					attribute<int32>  DOCUMENTDATUM             (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/DOCUMENTDATUM', ',') + ')';
					attribute<string> DOCUMENTNUMMER            (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/DOCUMENTNUMMER', ',') + ')';

					attribute<bool>   IS_GECONSTATEERD          (src) := = 'union_data(.., ' + asList('Filesets/nr_' +  string(id(fileset)) + '/store/meta/IS_GECONSTATEERD', ',') + ')';
				}
			}

			container impl :=
				='datum_conditie(src, prik_datum, src/meta/BEGINDATUM, src/meta/EINDDATUM, src/meta/status_sel, ' + (met_geo_sel 
						? 'True,  src/geo_selectie'
						: 'False'
					)
				+ ')'
			;

			// De selectie hoort hier en niet in de template: een unit die als case parameter wordt
			// meegegeven draagt de sub-items van een MMD store niet mee (GeoDMS 20.19.1).
			unit<uint32> selectie := select_with_attr_by_org_rel(src, impl/conditie)
			, DialogType = "Map"
			, DialogData = "geometry"
			{
				container meta := collect_attr_by_org_rel(src/meta, selectie, org_rel);
				attribute<geometries/rdc> geometry_raw_or_centroid := MakeDefined(src/geometry, src/centroid)[org_rel]; // Op snapshot moment willen we alleen punt geometrien hebben voor vbo's
				attribute<float64> X := PointCol(geometry_raw_or_centroid);
				attribute<float64> Y := PointRow(geometry_raw_or_centroid);
				attribute<geometries/rdc> geometry_in_nl :=
					   X >=  -8000d &&  X <= 300000d
					&& Y >= 289000d &&  Y <= 629000d
						? geometry_raw_or_centroid
						: point_xy(0d/0d, 0d/0d, geometries/rdc);
				// Op snapshot moment willen we alleen geometrien in NL (https://nl.wikipedia.org/wiki/Rijksdriehoeksco%C3%B6rdinaten), dit ten behoeve van gemiddelde bepalingen (denk aan coordinaten voor geocode)

				attribute<result> result_rel := rlookup(identificatie,result/identificatie);
				attribute<string> key        := identificatie + '_' + string(meta/VOORKOMENIDENTIFICATIE);

				container gebruiksdoelen := collect_attr_by_org_rel(src/gebruiksdoelen, selectie, org_rel);
			}

			unit<uint32> result_base := unique(selectie/identificatie);

			unit<uint32> result := TiledUnit(1000000[result_base])
			,	DialogType  = "Map"
			,	DialogData  = "geometry"
			{
				attribute<uint32>            count               := pcount(selectie/result_rel), DisableStorage = "True";

				attribute<geometries/rdc>    geometry            := rjoin(identificatie, selectie/identificatie, selectie/geometry_in_nl);
				attribute<string>            identificatie       := result_base/values[mapping(result, result_base)];
				attribute<int32>             oppervlakte         := last(selectie/oppervlakte, selectie/result_rel);
				attribute<string>            nummeraanduiding_id := last(selectie/nummeraanduiding_id, selectie/result_rel);

				attribute<string>            pand_id             := last(gerelateerdPand/pand_id, rlookup(gerelateerdPand/identificatie, identificatie));
				attribute<pand/result>       pand_rel            := point_in_polygon(geometry, pand/result/geometry), DisableStorage = "True";
				attribute<string>            pand_id_geom        := pand/result/identificatie[pand_rel];
				attribute<string>            key                 := identificatie + '_' + string(max(selectie/meta/VOORKOMENIDENTIFICATIE, selectie/result_rel)), DisableStorage = "True";

				container gebruiksdoelen:=
					for_each_nedv(
						typeringen/gebruiksdoel_vbo/name
						, 'last(selectie/gebruiksdoelen/' + typeringen/gebruiksdoel_vbo/name + ', selectie/result_rel)'
						, result
						, bool
					);

				container meta := meta_template(selectie,.);

				unit<uint32> gerelateerdPand := select_with_attr_by_cond(src/gerelateerdPand,
					IsDefined(
						rlookup(  string(src/gerelateerdPand/fileset_rel)        + '_' + string(src/gerelateerdPand/mutatie_rel)
								, string(src/fileset_rel[selectie/org_rel]) + '_' + string(src/mutatie_rel[selectie/org_rel])
							)
						)
					), DisableStorage = "True"
				{
					attribute<uint32> mutatie_rel: DisableStorage = "True";
					attribute<uint32> fileset_rel: DisableStorage = "True";

					attribute<string> identificatie := rjoin(
						  string(fileset_rel) + '_' + string(mutatie_rel)
						, string(src/fileset_rel) + '_' + string(src/mutatie_rel)
						, src/identificatie);
				}

				unit<uint32> nevenadres := select_with_attr_by_cond(src/nevenadres,  // is een 1->0..n relatie
					IsDefined(
						rlookup(  string(src/nevenadres/fileset_rel)             + '_' + string(src/nevenadres/mutatie_rel)
								, string(src/fileset_rel[selectie/org_rel]) + '_' + string(src/mutatie_rel[selectie/org_rel])
							)
						)
					)
				{
					attribute<uint32> mutatie_rel: DisableStorage = "True";
					attribute<uint32> fileset_rel: DisableStorage = "True";

					attribute<string> identificatie       := rjoin(
						  string(fileset_rel) + '_' + string(mutatie_rel)
						, string(src/fileset_rel) + '_' + string(src/mutatie_rel)
						, src/identificatie);
				}
			}
		}

		container nummeraanduiding
		{
			unit<uint32> src
			:	StorageName     = "= StoreDir + '/nummeraanduiding.mmd'"
			,	StorageReadOnly = "True"
			{
			}

			// Een MMD-leesholder mag zelf niets declareren; de dictionary van de store doet dat.
			container afgeleid
			{
				container status := status_selectie(src, typeringen/status/nummeraanduiding, src/meta/STATUS);
				attribute<bool> OpenbareruimteInSelectie (src) := isDefined(rlookup(src/openbareruimte_id, openbareruimte/result/identificatie));
			}

			container impl:=
				='datum_conditie(src, prik_datum, src/meta/BEGINDATUM, src/meta/EINDDATUM, afgeleid/status/status_sel, ' + (met_geo_sel 
						? 'True,  afgeleid/OpenbareruimteInSelectie'
						: 'False'
					)
				+ ')'
			;

			// De selectie hoort hier en niet in de template: een unit die als case parameter wordt
			// meegegeven draagt de sub-items van een MMD store niet mee (GeoDMS 20.19.1).
			unit<uint32> selectie := select_with_attr_by_org_rel(src, impl/conditie)
			, DialogType = "Map"
			, DialogData = "geometry"
			{
				container meta := collect_attr_by_org_rel(src/meta, selectie, org_rel);
				attribute<result> result_rel := rlookup(identificatie, result/identificatie);
				attribute<string> key        := identificatie + '_' + string(meta/VOORKOMENIDENTIFICATIE);
			}

			unit<uint32> result_base := unique(selectie/identificatie);

			unit<uint32> result := TiledUnit(1000000[result_base])
			{
				attribute<uint32> count := pcount(selectie/result_rel), DisableStorage = "True";

				attribute<string> identificatie           := result_base/values[mapping(result, result_base)];
				attribute<int32>  huisnummer              := last(selectie/huisnummer              , selectie/result_rel);
				attribute<string> huisletter              := last(selectie/huisletter              , selectie/result_rel);
				attribute<string> toevoeging              := last(selectie/toevoeging              , selectie/result_rel);
				attribute<string> postcode                := last(selectie/postcode                , selectie/result_rel);
				attribute<string> typeAdresseerbaarObject := last(selectie/typeAdresseerbaarObject , selectie/result_rel);
				attribute<string> openbareruimte_id       := last(selectie/openbareruimte_id       , selectie/result_rel);
				attribute<string> woonplaats_id           := last(selectie/woonplaats_id           , selectie/result_rel);

				attribute<string> key                     := identificatie + '_' + string(max(selectie/meta/VOORKOMENIDENTIFICATIE, selectie/result_rel)), DisableStorage = "True";

				container meta := meta_template(selectie, .);
			}
		}

		container openbareruimte
		{
			unit<uint32> src
			: StorageName     = "= StoreDir + '/openbareruimte.mmd'"
			, StorageReadOnly = "True"
			{
			}

			// Een MMD-leesholder mag zelf niets declareren; de dictionary van de store doet dat.
			container afgeleid
			{
				container status := status_selectie(src, typeringen/status/openbareruimte, src/meta/STATUS);
				attribute<bool> Woonplaatsgeo_selectie (src) := isDefined(rlookup(src/woonplaats_id, woonplaats/result/identificatie));
			}

			container impl :=
				='datum_conditie(src, prik_datum, src/meta/BEGINDATUM, src/meta/EINDDATUM, afgeleid/status/status_sel, ' + (met_geo_sel 
						? 'True,  afgeleid/Woonplaatsgeo_selectie'
						: 'False'
					)
				+ ')'
			;

			// De selectie hoort hier en niet in de template: een unit die als case parameter wordt
			// meegegeven draagt de sub-items van een MMD store niet mee (GeoDMS 20.19.1).
			unit<uint32> selectie := select_with_attr_by_org_rel(src, impl/conditie)
			, DialogType = "Map"
			, DialogData = "geometry"
			{
				container meta := collect_attr_by_org_rel(src/meta, selectie, org_rel);
				attribute<result> result_rel := rlookup(identificatie,result/values);
				attribute<string> key        := identificatie + '_' + string(meta/VOORKOMENIDENTIFICATIE);
			}

			unit<uint32> result := unique(selectie/identificatie)
			{
				attribute<uint32> count  := pcount(selectie/result_rel), DisableStorage = "True";
				attribute<string> values : DisableStorage = "True";

				attribute<string> identificatie := values;
				attribute<string> naam          := last(selectie/naam         , selectie/result_rel);
				attribute<string> type          := last(selectie/type         , selectie/result_rel);
				attribute<string> woonplaats_id := last(selectie/woonplaats_id, selectie/result_rel);
				attribute<string> key           := identificatie + '_' + string(max(selectie/meta/VOORKOMENIDENTIFICATIE, selectie/result_rel)), DisableStorage = "True";
				container meta := meta_template(selectie, .);
			}

		}

		container woonplaats
		{
			unit<uint32> src
			:	StorageName     = "= StoreDir + '/woonplaats.mmd'"
			,	StorageReadOnly = "True"
			{
			}

			// Een MMD-leesholder mag zelf niets declareren; de dictionary van de store doet dat.
			container afgeleid
			{
				container status       := status_selectie(src, typeringen/status/woonplaats, src/meta/STATUS);
				container geo_selectie := = met_geo_sel
					? 'polygon_selectie(src, src/geometry)'
					: 'nl_selectie(src)';
			}

			container impl :=
				='datum_conditie(src, prik_datum, src/meta/BEGINDATUM, src/meta/EINDDATUM, afgeleid/status/status_sel, ' + (met_geo_sel 
						? 'True,  afgeleid/geo_selectie/result'
						: 'False'
					)
				+ ')'
			;

			// De selectie hoort hier en niet in de template: een unit die als case parameter wordt
			// meegegeven draagt de sub-items van een MMD store niet mee (GeoDMS 20.19.1).
			unit<uint32> selectie := select_with_attr_by_org_rel(src, impl/conditie)
			, DialogType = "Map"
			, DialogData = "geometry"
			{
				container meta := collect_attr_by_org_rel(src/meta, selectie, org_rel);
				attribute<result> result_rel := rlookup(identificatie,result/values);
				attribute<string> key        := identificatie + '_' + string(meta/VOORKOMENIDENTIFICATIE);
			}
			unit<uint32> result := unique(selectie/identificatie)
			{
				attribute<uint32> count  := pcount(selectie/result_rel), DisableStorage = "True";
				attribute<string> values : DisableStorage = "True";

				attribute<geometries/rdc>    geometry    (polygon) := rjoin(values, selectie/identificatie, selectie/geometry);
				attribute<string>            identificatie         := values;
				attribute<string>            woonplaatsNaam        := last(selectie/woonplaatsNaam, selectie/result_rel);

				attribute<string>            key                   := identificatie + '_' + string(max(selectie/meta/VOORKOMENIDENTIFICATIE, selectie/result_rel)),
					DisableStorage = "True";

				container meta := meta_template(selectie, .);
			}

		}
		#include<afleidingen.dms>
		#include<overzichten.dms>
		#include<pc6.dms>
	}

	// De hele snapshot in een MMD store. Verwijzingen tussen de objecttypes blijven daardoor
	// relaties in plaats van sleutelstrings, en de classificaties reizen zelfbeschrijvend mee.
	// Een sleutel die met lookup(A/B_rel, B/identificatie) terug te halen is, wordt niet bewaard.
	container snapshot_store
	:	StorageName = "= SnapshotDir + '/bag.mmd'"
	{
			// ---- classificaties, eenmalig en zelfbeschrijvend in de store
			unit<uint8> status_ligplaats := typeringen/status/ligplaats
			{
				attribute<string> Label := typeringen/status/ligplaats/label, DialogType = "LabelText";
				attribute<bool>   selected := typeringen/status/ligplaats/selected;
			}
			// standplaats deelt de codelijst van ligplaats (zie status.dms: standplaats := ligplaats),
			// dus standplaats/meta/status_rel verwijst hieronder naar status_ligplaats.
			unit<uint8> status_pand := typeringen/status/pand
			{
				attribute<string> Label := typeringen/status/pand/label, DialogType = "LabelText";
				attribute<bool>   selected := typeringen/status/pand/selected;
			}
			unit<uint8> status_vbo := typeringen/status/vbo
			{
				attribute<string> Label := typeringen/status/vbo/label, DialogType = "LabelText";
				attribute<bool>   selected := typeringen/status/vbo/selected;
			}
			unit<uint8> status_nummeraanduiding := typeringen/status/nummeraanduiding
			{
				attribute<string> Label := typeringen/status/nummeraanduiding/label, DialogType = "LabelText";
				attribute<bool>   selected := typeringen/status/nummeraanduiding/selected;
			}
			unit<uint8> status_openbareruimte := typeringen/status/openbareruimte
			{
				attribute<string> Label := typeringen/status/openbareruimte/label, DialogType = "LabelText";
				attribute<bool>   selected := typeringen/status/openbareruimte/selected;
			}
			unit<uint8> status_woonplaats := typeringen/status/woonplaats
			{
				attribute<string> Label := typeringen/status/woonplaats/label, DialogType = "LabelText";
				attribute<bool>   selected := typeringen/status/woonplaats/selected;
			}
			unit<uint8> type_woonpand := object/afleidingen/pand_attributen/geometrie/type_woonpand
			{
				attribute<string> Label      := object/afleidingen/pand_attributen/geometrie/type_woonpand/label,      DialogType = "LabelText";
				attribute<string> name       := object/afleidingen/pand_attributen/geometrie/type_woonpand/name;
				attribute<uint32> BrushColor := object/afleidingen/pand_attributen/geometrie/type_woonpand/BrushColor, DialogType = "BrushColor";
				attribute<uint32> PenColor   := BrushColor,    DialogType = "PenColor";
			}

			// ---- objecttypes, in volgorde van verwijzing
			unit<uint32> woonplaats := object/woonplaats/result
			{
				attribute<geometries/rdc> geometry (polygon) := object/woonplaats/result/geometry;
				attribute<string>         identificatie      := object/woonplaats/result/identificatie;
				attribute<string>         woonplaatsNaam     := object/woonplaats/result/woonplaatsNaam;

				container meta
				{
					// de status als code in plaats van als string; status_woonplaats draagt de labels
					attribute<status_woonplaats> status_rel (woonplaats) := rlookup(lowercase(object/woonplaats/result/meta/Status), status_woonplaats/Label);
					attribute<eenheden/datum>   BEGINDATUM              (woonplaats) := object/woonplaats/result/meta/BEGINDATUM;
					attribute<eenheden/datum>   EINDDATUM               (woonplaats) := object/woonplaats/result/meta/EINDDATUM;
					attribute<uint32>           VOORKOMENIDENTIFICATIE  (woonplaats) := object/woonplaats/result/meta/VOORKOMENIDENTIFICATIE;
					attribute<string>           TIJDSTIPREGISTRATIE     (woonplaats) := object/woonplaats/result/meta/TIJDSTIPREGISTRATIE;
					attribute<string>           EINDREGISTRATIE         (woonplaats) := object/woonplaats/result/meta/EINDREGISTRATIE;
					attribute<eenheden/datum>   DOCUMENTDATUM           (woonplaats) := object/woonplaats/result/meta/DOCUMENTDATUM;
					attribute<string>           DOCUMENTNUMMER          (woonplaats) := object/woonplaats/result/meta/DOCUMENTNUMMER;
					attribute<bool>             IS_GECONSTATEERD        (woonplaats) := object/woonplaats/result/meta/IS_GECONSTATEERD;
				}
			}

			unit<uint32> openbareruimte := object/openbareruimte/result
			{
				attribute<string> identificatie := object/openbareruimte/result/identificatie;
				attribute<string> naam          := object/openbareruimte/result/naam;
				attribute<string> type          := object/openbareruimte/result/type;
				attribute<woonplaats>         woonplaats_rel         := rlookup(object/openbareruimte/result/woonplaats_id, woonplaats/identificatie);

				container meta
				{
					// de status als code in plaats van als string; status_openbareruimte draagt de labels
					attribute<status_openbareruimte> status_rel (openbareruimte) := rlookup(lowercase(object/openbareruimte/result/meta/Status), status_openbareruimte/Label);
					attribute<eenheden/datum>   BEGINDATUM              (openbareruimte) := object/openbareruimte/result/meta/BEGINDATUM;
					attribute<eenheden/datum>   EINDDATUM               (openbareruimte) := object/openbareruimte/result/meta/EINDDATUM;
					attribute<uint32>           VOORKOMENIDENTIFICATIE  (openbareruimte) := object/openbareruimte/result/meta/VOORKOMENIDENTIFICATIE;
					attribute<string>           TIJDSTIPREGISTRATIE     (openbareruimte) := object/openbareruimte/result/meta/TIJDSTIPREGISTRATIE;
					attribute<string>           EINDREGISTRATIE         (openbareruimte) := object/openbareruimte/result/meta/EINDREGISTRATIE;
					attribute<eenheden/datum>   DOCUMENTDATUM           (openbareruimte) := object/openbareruimte/result/meta/DOCUMENTDATUM;
					attribute<string>           DOCUMENTNUMMER          (openbareruimte) := object/openbareruimte/result/meta/DOCUMENTNUMMER;
					attribute<bool>             IS_GECONSTATEERD        (openbareruimte) := object/openbareruimte/result/meta/IS_GECONSTATEERD;
				}
			}

			unit<uint32> nummeraanduiding := object/nummeraanduiding/result
			{
				attribute<string> identificatie           := object/nummeraanduiding/result/identificatie;
				attribute<int32>  huisnummer              := object/nummeraanduiding/result/huisnummer;
				attribute<string> huisletter              := object/nummeraanduiding/result/huisletter;
				attribute<string> toevoeging              := object/nummeraanduiding/result/toevoeging;
				attribute<string> postcode                := object/nummeraanduiding/result/postcode;
				attribute<string> typeAdresseerbaarObject := object/nummeraanduiding/result/typeAdresseerbaarObject;
				attribute<openbareruimte>     openbareruimte_rel     := rlookup(object/nummeraanduiding/result/openbareruimte_id, openbareruimte/identificatie);
				attribute<woonplaats>         woonplaats_rel         := rlookup(object/nummeraanduiding/result/woonplaats_id, woonplaats/identificatie);

				// het adres zelf: de geometrie van het bijbehorende object en de namen die daarbij horen
				attribute<geometries/rdc>     geometry               := object/afleidingen/adres/geometry;
				attribute<float64>            X                      := object/afleidingen/adres/X;
				attribute<float64>            Y                      := object/afleidingen/adres/Y;
				attribute<string>             straatnaam             := object/afleidingen/adres/straatnaam;
				attribute<string>             woonplaatsnaam         := object/afleidingen/adres/woonplaatsnaam;

				container meta
				{
					// de status als code in plaats van als string; status_nummeraanduiding draagt de labels
					attribute<status_nummeraanduiding> status_rel (nummeraanduiding) := rlookup(lowercase(object/nummeraanduiding/result/meta/Status), status_nummeraanduiding/Label);
					attribute<eenheden/datum>   BEGINDATUM              (nummeraanduiding) := object/nummeraanduiding/result/meta/BEGINDATUM;
					attribute<eenheden/datum>   EINDDATUM               (nummeraanduiding) := object/nummeraanduiding/result/meta/EINDDATUM;
					attribute<uint32>           VOORKOMENIDENTIFICATIE  (nummeraanduiding) := object/nummeraanduiding/result/meta/VOORKOMENIDENTIFICATIE;
					attribute<string>           TIJDSTIPREGISTRATIE     (nummeraanduiding) := object/nummeraanduiding/result/meta/TIJDSTIPREGISTRATIE;
					attribute<string>           EINDREGISTRATIE         (nummeraanduiding) := object/nummeraanduiding/result/meta/EINDREGISTRATIE;
					attribute<eenheden/datum>   DOCUMENTDATUM           (nummeraanduiding) := object/nummeraanduiding/result/meta/DOCUMENTDATUM;
					attribute<string>           DOCUMENTNUMMER          (nummeraanduiding) := object/nummeraanduiding/result/meta/DOCUMENTNUMMER;
					attribute<bool>             IS_GECONSTATEERD        (nummeraanduiding) := object/nummeraanduiding/result/meta/IS_GECONSTATEERD;
				}
			}

			unit<uint32> ligplaats := object/ligplaats/result
			{
				attribute<geometries/rdc> geometry (polygon) := object/ligplaats/result/geometry;
				attribute<string>         identificatie      := object/ligplaats/result/identificatie;
				attribute<nummeraanduiding>   nummeraanduiding_rel   := rlookup(object/ligplaats/result/nummeraanduiding_id, nummeraanduiding/identificatie);

				container meta
				{
					// de status als code in plaats van als string; status_ligplaats draagt de labels
					attribute<status_ligplaats> status_rel (ligplaats) := rlookup(lowercase(object/ligplaats/result/meta/Status), status_ligplaats/Label);
					attribute<eenheden/datum>   BEGINDATUM              (ligplaats) := object/ligplaats/result/meta/BEGINDATUM;
					attribute<eenheden/datum>   EINDDATUM               (ligplaats) := object/ligplaats/result/meta/EINDDATUM;
					attribute<uint32>           VOORKOMENIDENTIFICATIE  (ligplaats) := object/ligplaats/result/meta/VOORKOMENIDENTIFICATIE;
					attribute<string>           TIJDSTIPREGISTRATIE     (ligplaats) := object/ligplaats/result/meta/TIJDSTIPREGISTRATIE;
					attribute<string>           EINDREGISTRATIE         (ligplaats) := object/ligplaats/result/meta/EINDREGISTRATIE;
					attribute<eenheden/datum>   DOCUMENTDATUM           (ligplaats) := object/ligplaats/result/meta/DOCUMENTDATUM;
					attribute<string>           DOCUMENTNUMMER          (ligplaats) := object/ligplaats/result/meta/DOCUMENTNUMMER;
					attribute<bool>             IS_GECONSTATEERD        (ligplaats) := object/ligplaats/result/meta/IS_GECONSTATEERD;
				}

				unit<uint32> nevenadres := object/ligplaats/result/nevenadres
				{
					attribute<ligplaats>        ligplaats_rel := rlookup(object/ligplaats/result/nevenadres/identificatie, ligplaats/identificatie);
					attribute<nummeraanduiding> nummeraanduiding_rel := rlookup(object/ligplaats/result/nevenadres/nummeraanduiding_id, nummeraanduiding/identificatie);
				}
			}

			unit<uint32> standplaats := object/standplaats/result
			{
				attribute<geometries/rdc> geometry (polygon) := object/standplaats/result/geometry;
				attribute<string>         identificatie      := object/standplaats/result/identificatie;
				attribute<nummeraanduiding>   nummeraanduiding_rel   := rlookup(object/standplaats/result/nummeraanduiding_id, nummeraanduiding/identificatie);

				container meta
				{
					// de status als code in plaats van als string; status_ligplaats draagt de labels
					attribute<status_ligplaats>   status_rel (standplaats) := rlookup(lowercase(object/standplaats/result/meta/Status), status_ligplaats/Label);
					attribute<eenheden/datum>   BEGINDATUM              (standplaats) := object/standplaats/result/meta/BEGINDATUM;
					attribute<eenheden/datum>   EINDDATUM               (standplaats) := object/standplaats/result/meta/EINDDATUM;
					attribute<uint32>           VOORKOMENIDENTIFICATIE  (standplaats) := object/standplaats/result/meta/VOORKOMENIDENTIFICATIE;
					attribute<string>           TIJDSTIPREGISTRATIE     (standplaats) := object/standplaats/result/meta/TIJDSTIPREGISTRATIE;
					attribute<string>           EINDREGISTRATIE         (standplaats) := object/standplaats/result/meta/EINDREGISTRATIE;
					attribute<eenheden/datum>   DOCUMENTDATUM           (standplaats) := object/standplaats/result/meta/DOCUMENTDATUM;
					attribute<string>           DOCUMENTNUMMER          (standplaats) := object/standplaats/result/meta/DOCUMENTNUMMER;
					attribute<bool>             IS_GECONSTATEERD        (standplaats) := object/standplaats/result/meta/IS_GECONSTATEERD;
				}

				unit<uint32> nevenadres := object/standplaats/result/nevenadres
				{
					attribute<standplaats>      standplaats_rel := rlookup(object/standplaats/result/nevenadres/identificatie, standplaats/identificatie);
					attribute<nummeraanduiding> nummeraanduiding_rel := rlookup(object/standplaats/result/nevenadres/nummeraanduiding_id, nummeraanduiding/identificatie);
				}
			}

			unit<uint32> pand := object/pand/result
			{
				attribute<geometries/rdc> geometry (polygon) := object/pand/result/geometry;
				attribute<string>         identificatie      := object/pand/result/identificatie;
				attribute<eenheden/jaar>  bouwjaar           := object/pand/result/bouwjaar;
				attribute<type_woonpand>  woonpand_type_rel  := object/pand/result/woningtype/WOONPAND_TYPE[type_woonpand];

				container meta
				{
					// de status als code in plaats van als string; status_pand draagt de labels
					attribute<status_pand> status_rel (pand) := rlookup(lowercase(object/pand/result/meta/Status), status_pand/Label);
					attribute<eenheden/datum>   BEGINDATUM              (pand) := object/pand/result/meta/BEGINDATUM;
					attribute<eenheden/datum>   EINDDATUM               (pand) := object/pand/result/meta/EINDDATUM;
					attribute<uint32>           VOORKOMENIDENTIFICATIE  (pand) := object/pand/result/meta/VOORKOMENIDENTIFICATIE;
					attribute<string>           TIJDSTIPREGISTRATIE     (pand) := object/pand/result/meta/TIJDSTIPREGISTRATIE;
					attribute<string>           EINDREGISTRATIE         (pand) := object/pand/result/meta/EINDREGISTRATIE;
					attribute<eenheden/datum>   DOCUMENTDATUM           (pand) := object/pand/result/meta/DOCUMENTDATUM;
					attribute<string>           DOCUMENTNUMMER          (pand) := object/pand/result/meta/DOCUMENTNUMMER;
					attribute<bool>             IS_GECONSTATEERD        (pand) := object/pand/result/meta/IS_GECONSTATEERD;
				}

				container gebruiksdoelen := for_each_nedv(
					  'nr_' + typeringen/gebruiksdoel_vbo/name
					, 'object/pand/result/gebruiksdoelen/nr_' + typeringen/gebruiksdoel_vbo/name
					, pand
					, uint32);
			}

			unit<uint32> vbo := object/vbo/result
			{
				attribute<geometries/rdc> geometry      := object/vbo/result/geometry;
				attribute<string>         identificatie := object/vbo/result/identificatie;
				attribute<int32>          oppervlakte   := object/vbo/result/oppervlakte;
				attribute<nummeraanduiding>   nummeraanduiding_rel   := rlookup(object/vbo/result/nummeraanduiding_id, nummeraanduiding/identificatie);
				attribute<pand>           pand_rel      := object/vbo/result/pand_rel[pand]; // pand waarin de vbo ligt

				container meta
				{
					// de status als code in plaats van als string; status_vbo draagt de labels
					attribute<status_vbo> status_rel (vbo) := rlookup(lowercase(object/vbo/result/meta/Status), status_vbo/Label);
					attribute<eenheden/datum>   BEGINDATUM              (vbo) := object/vbo/result/meta/BEGINDATUM;
					attribute<eenheden/datum>   EINDDATUM               (vbo) := object/vbo/result/meta/EINDDATUM;
					attribute<uint32>           VOORKOMENIDENTIFICATIE  (vbo) := object/vbo/result/meta/VOORKOMENIDENTIFICATIE;
					attribute<string>           TIJDSTIPREGISTRATIE     (vbo) := object/vbo/result/meta/TIJDSTIPREGISTRATIE;
					attribute<string>           EINDREGISTRATIE         (vbo) := object/vbo/result/meta/EINDREGISTRATIE;
					attribute<eenheden/datum>   DOCUMENTDATUM           (vbo) := object/vbo/result/meta/DOCUMENTDATUM;
					attribute<string>           DOCUMENTNUMMER          (vbo) := object/vbo/result/meta/DOCUMENTNUMMER;
					attribute<bool>             IS_GECONSTATEERD        (vbo) := object/vbo/result/meta/IS_GECONSTATEERD;
				}

				container gebruiksdoelen := for_each_nedv(
					  typeringen/gebruiksdoel_vbo/name
					, 'object/vbo/result/gebruiksdoelen/' + typeringen/gebruiksdoel_vbo/name
					, vbo
					, bool);

				unit<uint32> gerelateerdPand := object/vbo/result/gerelateerdPand // administratieve relatie uit de BAG
				{
					attribute<vbo>  vbo_rel  := rlookup(object/vbo/result/gerelateerdPand/identificatie, vbo/identificatie);
					attribute<pand> pand_rel := rlookup(object/vbo/result/gerelateerdPand/pand_id, pand/identificatie);
				}

				unit<uint32> nevenadres := object/vbo/result/nevenadres
				{
					attribute<vbo>              vbo_rel              := rlookup(object/vbo/result/nevenadres/identificatie, vbo/identificatie);
					attribute<nummeraanduiding> nummeraanduiding_rel := rlookup(object/vbo/result/nevenadres/nummeraanduiding_id, nummeraanduiding/identificatie);
				}
			}

			// Een aparte adressentabel is er niet meer: die was dezelfde domein-eenheid als
			// nummeraanduiding, met dezelfde postcode, huisnummer, huisletter en toevoeging.
	}

	// De PHN-hoogte is optioneel en heeft eigen brondata, dus die blijft een eigen store,
	// rij voor rij uitgelijnd met snapshot_store/pand.
	unit<uint32> pandhoogte_store := object/pand/result
	,	StorageName = "= SnapshotDir + '/pandhoogte.mmd'"
	{
		attribute<eenheden/cm_uint16> AHN_hoogte    := object/afleidingen/pand_attributen/hoogte/AHN_hoogte;
		attribute<uint16>             AHN_inwinjaar := object/afleidingen/pand_attributen/hoogte/AHN_inwinjaar;
	}

	#include<gdalwrite_vect_export.dms>
}
